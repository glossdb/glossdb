# --- the threshold is the test's: declared again, the stored backtest is out of date through it, and the next one
# sends the new threshold and stores the states the service judged with it

statement ok
DECLARE TEST range_test ON metric_ranges BY (AGENT, HUMAN) DETECTOR range_state THRESHOLD 0.95;

query T
SELECT DISTINCT input FROM glossql_outdated() WHERE function = 'metric_ranges';
----
annotations(metric_ranges, itself)

statement ok
SELECT metric_ranges() FROM fin;

query R
SELECT (value->>'threshold')::DOUBLE FROM measurements WHERE function = 'metric_ranges';
----
0.95

# --- a red range accepted: an agent's tolerance below the score leaves it red, a person's at or above it outranks the
# agent's and makes the test green, as for the views' checks

statement ok
GLOSS metric_ranges ON fin AS $${"tolerance": 0.5, "basis": "a guess"}$$;

query T
SELECT state FROM TESTS() WHERE test = 'range_test';
----
red

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS metric_ranges ON fin AS $${"tolerance": 1.0, "basis": "the January price change, decided by finance"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TT
SELECT subject, state FROM view_tests() WHERE test = 'range_test';
----
fin	green

# --- the forecast, on a metric: a monthly metric, twelve months ahead from the last complete period, the quarter
# and the year to go

statement ok
CREATE TABLE fin.budget AS
  SELECT (DATE '2025-01-01' + INTERVAL (m) MONTH)::DATE AS month,
         [120.0, 10.0, 90.0, 200.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 100.0, 1000.0][m + 1] AS planned
  FROM range(12) r(m);

statement ok
DECLARE ASPECT sales WITH $${"title": "Sales"}$$ AS VIEW;

statement ok
GLOSS sales ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS value FROM fin.ledger GROUP BY ALL"}$$;

statement ok
GLOSS role ON sales.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON sales.value AS $${"value": "measure"}$$;

statement ok
SELECT temporal() FROM sales.period;

statement ok
GLOSS additivity ON sales.value AS $${"value": "additive"}$$;

query TTTITTIT
SELECT metric, additivity, grain, horizon, applicable, origin::DATE, len(ahead), spans::VARCHAR FROM forecast_request() WHERE metric = 'sales';
----
sales	additive	month	12	true	2025-02-01	12	[{'span': 1, 'to_go': quarter}, {'span': 10, 'to_go': year}]

# one request per metric: the history as actual rows, the periods ahead as forecast rows
query TTTITT
SELECT metric, grain, totals::VARCHAR, json_array_length(json_extract(body, '$.table.member')),
       json_extract_string(body, '$.table.status[13]'), json_extract_string(body, '$.table.period[25]')
FROM forecast_bodies_of('the dataset''s metrics', 'the dataset''s metrics') ORDER BY metric;
----
hires	day	[24]	158	actual	2024-10-26
sales	month	[1, 10]	26	actual	2026-02-01
spend	day	[24]	432	actual	2024-01-26

