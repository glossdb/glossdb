statement ok
DECLARE TEST range_test ON metric_ranges BY (AGENT, HUMAN) DETECTOR range_state THRESHOLD 0.9;

statement ok
SELECT metric_ranges() FROM fin;

query TRRT
SELECT json_extract_string(value, '$.served_by'), (value->>'threshold')::DOUBLE, (value->>'score')::DOUBLE, value->>'state'
FROM measurements WHERE function = 'metric_ranges';
----
glossthesi test	0.9	1.0	red

query TTRRRRRRTR
SELECT metric, period, actual, p05, p50, p95, pit, displacement, (withheld) IS NOT NULL, coverage_80
FROM range_points() WHERE metric = 'spend' ORDER BY point_seq;
----
spend	2024-12	125.0	100.0	120.0	140.0	NULL	NULL	true	0.79
spend	2025-01	300.0	200.0	220.0	240.0	1.0	1.0	false	0.79

query TTIRRT
SELECT period, newest, backtested, held_80, score, state FROM range_points() WHERE metric = 'spend' ORDER BY point_seq;
----
2024-12	false	2	0.5	1.0	red
2025-01	true	2	0.5	1.0	red

# the metric the service could not backtest: its code and the reason the kit reads from it. The service also names
# each origin with too short a history; the metric's own code is the backtest's, with the periods it has
query TTTTI
SELECT metric, applicable, code, (reason) IS NOT NULL, list_extract(list_filter(m.errors, lambda e: e.origin IS NULL), 1).given
FROM range_points() r, (SELECT unnest(from_json(json_extract(value, '$.metrics'), '[{"metric": "VARCHAR", "errors": [{"code": "VARCHAR", "origin": "VARCHAR", "given": "BIGINT"}]}]')) AS m
                        FROM measurements WHERE function = 'metric_ranges') s
WHERE r.metric = 'hires' AND s.m.metric = 'hires';
----
hires	false	origins_short	true	4

query TTTR
SELECT subject, test, state, score FROM TESTS() WHERE test = 'range_test';
----
fin	range_test	red	1.0

# the test is a row of view_tests() on the dataset, with no view: the result carries the finding (the metric the
# service judged red) and the fix, which runs the backtest again or records a person's acceptance
query TTTTTT
SELECT view, subject, state, run, contains(evidence->>'finding', 'spend is 300.0 at 2025-01'),
       contains(evidence->>'fix', 'GLOSS metric_ranges ON fin AS $${"tolerance": 1.0')
FROM view_tests() WHERE test = 'range_test';
----
(empty)	fin	red	(empty)	true	true

# --- a repeat is served; a change to what the backtest read owes a new one

statement ok
SELECT metric_ranges() FROM fin;

query I
SELECT count(*) FROM measurements_history WHERE function = 'metric_ranges' AND error IS NULL;
