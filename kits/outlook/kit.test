":0.89,"se":0.03,"points":500,"datasets":10}]}}'::JSON;

statement ok
SELECT metric_forecast() FROM fin;

# the other metrics got no point from the stand-in; sales its twelve steps and two totals, each once,
# though both month bodies answered the service's coverage at the month
query TTT
SELECT metric, applicable, (reason) IS NOT NULL FROM forecast_points() WHERE metric <> 'sales' ORDER BY metric;
----
balance	false	true
hires	false	true
spend	false	true

query I
SELECT count(*) FROM forecast_points() WHERE metric = 'sales';
----
14

query IIITTRRRRT
SELECT point_seq, step, span, to_go, period, p10, p50, p90, held_80, held_from FROM forecast_points() WHERE metric = 'sales' AND point_seq IN (0, 2, 12, 13) ORDER BY point_seq;
----
0	1	NULL	NULL	2025-03-01	80.0	100.0	120.0	0.8	service
2	3	NULL	NULL	2025-05-01	80.0	100.0	120.0	NULL	NULL
12	1	1	quarter	2025-03-01	80.0	100.0	120.0	0.79	service
13	10	10	year	2025-12-01	1000.0	1100.0	1400.0	0.79	service

query TTTT
SELECT grain, origin, served_by, current FROM forecast_points() WHERE metric = 'sales' LIMIT 1;
----
month	2025-02-01	glossthesi test	true

# nothing has loaded past the origin: the catalog tallies no point yet, and says so with no row
query I
SELECT count(*) FROM forecast_coverage();
----
0

# --- run again from the same origin (an annotation elsewhere moved the catalog), the forecast is a second run
# and still one point per metric, origin, step and span

statement ok
GLOSS meaning ON fin.ledger AS $${"value": "one booking"}$$;

statement ok
SELECT metric_forecast() FROM fin;

query II
SELECT count(*), count(DISTINCT origin) FROM measurements_history m, (SELECT DISTINCT origin FROM forecast_stored() WHERE metric = 'sales') o
WHERE m.function = 'metric_forecast';
----
2	1

query II
SELECT (SELECT count(*) FROM forecast_runs() WHERE metric = 'sales'), (SELECT count(*) FROM forecast_scored() WHERE metric = 'sales');
----
28	14

# the forecast world: the medians at the forecast's grain, under the metric
query TTIR
SELECT metric, world, count(*), any_value(value) FROM metric_series(world := 'forecast', grain := 'month') GROUP BY ALL;
----
sales	forecast	12	100.0

# --- the plan: a VIEW aspect with x-kind plan and x-plan-of, read through the metric it plans

statement ok
DECLARE ASPECT sales_budget WITH $${"title": "Sales budget", "x-kind": "plan", "x-plan-of": "sales"}$$ AS VIEW;

# declared and not defined: no fact row yet, as for a metric; the plan goal asks for the metric definition
query I
SELECT count(*) FROM view_summary() WHERE view = 'sales_budget';
----
0

statement ok
GLOSS sales_budget ON fin AS $${"sql": "SELECT month AS period, planned AS value FROM fin.budget"}$$;

query TTTTTT
SELECT view, plan_of, applicable, period_column, value_column, additivity FROM view_summary() WHERE view = 'sales_budget';
----
sales_budget	sales	true	period	value	additive

# a plan is no metric of the actual world, and neither the backtest nor the forecast reads it
query I
SELECT count(*) FROM metric_series(grain := 'month') WHERE metric = 'sales_budget';
----
0

query I
SELECT count(*) FROM range_request() WHERE metric = 'sales_budget';
----
0

query TTIR
SELECT metric, world, count(*), sum(value) FROM metric_series(world := 'plan', plan := 'sales_budget', grain := 'month') GROUP BY ALL;
----
sales	plan	12	2120.0

query TR
SELECT period::DATE, value FROM metric_series(world := 'plan', plan := 'sales_budget', grain := 'year');
----
2025-01-01	2120.0

query I
SELECT count(*) FROM metric_series(world := 'plan', plan := 'sales_budget', grain := 'day');
----
0

statement error
SELECT * FROM metric_series(world := 'plan', grain := 'month');
