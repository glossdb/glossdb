statement ok
SELECT metric_forecast() FROM fin.sales;

statement ok
SELECT metric_ranges() FROM fin;

# --- the scenario: a lever on a column of a metric's view, a scenario of a factor per period, the estimate ahead from
# the service

statement ok
DECLARE ASPECT priced WITH $${"title": "Priced spend"}$$ AS VIEW;

statement ok
GLOSS priced ON fin AS $${"sql": "SELECT booked AS period, amount AS value, 10.0 + amount / 10 AS price, CASE WHEN booked >= DATE '2025-02-01' THEN 0.0 ELSE 1.0 END AS promo FROM fin.ledger"}$$;

statement ok
GLOSS role ON priced.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON priced.value AS $${"value": "measure"}$$;

statement ok
SELECT temporal() FROM priced.period;

statement ok
GLOSS additivity ON priced.value AS $${"value": "additive"}$$;

statement ok
DECLARE ASPECT price_up WITH $${"title": "Price +10% in February", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

# declared and not annotated
query TTTT
SELECT scenario, annotated, applicable, (reason) IS NOT NULL FROM scenarios();
----
price_up	false	false	true

# a lever nobody annotated: the scenario is judged once, and its fix annotates it again with the body judged, a
# person's over an agent's
statement ok
GLOSS price_up ON fin AS $${"levers": [{"column": "priced.price", "factor": {"2025-02": 1.2}, "basis": "the agent's draft"}]}$$;

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS price_up ON fin AS $${"levers": [{"column": "priced.price", "factor": {"2025-02": 1.1}, "basis": "the February price list"}]}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTT
SELECT applicable, contains(fix, 'GLOSS price_up ON fin AS $$'), contains(fix, '"factor":{"2025-02":1.1}') OR contains(fix, '"factor": {"2025-02": 1.1}')
FROM scenarios();
----
false	true	true

statement ok
GLOSS lever ON priced.price AS $${"value": true, "basis": "the list price, set each quarter"}$$;

statement ok
GLOSS lever ON priced.promo AS $${"value": true, "basis": "the promotion flag"}$$;

query TTTT
SELECT applicable, reason, len(levers), fix FROM scenarios();
----
true	NULL	1	NULL

# the reach: priced runs daily, its last day 2025-02-04; the scenario names February, so 24 days ahead
query TTTTI
SELECT scenario, metric, grain, origin::DATE, len(ahead) FROM scenario_request();
----
price_up	priced	day	2025-02-04	24

# the request: the history, then each day ahead twice; the lever held at its last value as planned, times the factor
# under the scenario
query TTTRR
SELECT metric, json_extract_string(body, '$.table.status[401]'), json_extract_string(body, '$.table.status[402]'),
       json_extract(body, '$.table."priced.price"[401]')::DOUBLE, round(json_extract(body, '$.table."priced.price"[402]')::DOUBLE, 2)
FROM scenario_bodies_of('the dataset''s metrics', 'the dataset''s metrics', NULL, NULL);
----
priced	plan	scenario	10.3	11.33

# with the lever's forecast as the planned input: its median where it reaches, its last median past that
query RRRR
SELECT json_extract(body, '$.table."priced.price"[403]')::DOUBLE, round(json_extract(body, '$.table."priced.price"[404]')::DOUBLE, 2),
       json_extract(body, '$.table."priced.price"[407]')::DOUBLE, round(json_extract(body, '$.table."priced.price"[408]')::DOUBLE, 2)
FROM scenario_bodies_of('the dataset''s metrics', 'the dataset''s metrics', NULL,
                        '{"price_up|priced.price": [{"period": "2025-02-06", "value": 10.5}, {"period": "2025-02-07", "value": 10.6}]}');
----
10.5	11.55	10.6	11.66

# the lever's own forecast request: the series as the member, the days ahead within the day grain's reach of 31
query TTIT
SELECT lever, grain, horizon, json_extract_string(body, '$.table.status[401]')
FROM lever_bodies_of('the dataset''s metrics', 'the dataset''s metrics', NULL);
----
priced.price	day	24	forecast

statement ok
SELECT metric_scenario() FROM fin.priced;

# each period ahead answered twice, as planned (the baseline) and under the scenario, with the service's effect
query TTTITRRRRRT
SELECT scenario, metric, grain, step, period::DATE, low, value, high, baseline, effect, sign FROM scenario_points('price_up');
----
price_up	priced	day	1	2025-02-06	4.1	5.0	5.9	4.5	0.5	+
price_up	priced	day	2	2025-02-07	4.2	5.1	6.0	4.6	0.5	+
price_up	priced	day	3	2025-02-08	4.3	5.2	6.1	4.7	0.5	+

query TTTRRR
SELECT metric, lever, planned_from, history_shift, history_low, history_high FROM scenario_levers('price_up');
----
priced	priced.price	forecast	0.5	0.2	0.8

# the scenario world under the metric: the estimate's medians ahead
query TTIR
SELECT metric, world, count(*), sum(value) FROM metric_series(world := 'scenario', scenario := 'price_up') GROUP BY ALL;
----
priced	scenario	3	15.3

statement error
SELECT * FROM metric_series(world := 'scenario');
----
scenario_not_named

statement error
SELECT * FROM metric_series(world := 'scenario', scenario := 'nothing');
----
unknown_scenario

statement error
SELECT * FROM metric_series(world := 'dream');
----
unknown_world

# a scenario that moves no input — the lever held at nothing as planned — is sent, and the service answers its code
statement ok
DECLARE ASPECT promo_on WITH $${"title": "Promotion doubled", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

statement ok
GLOSS promo_on ON fin AS $${"levers": [{"column": "priced.promo", "factor": {"2025-02": 2.0}, "basis": "twice the promotion"}]}$$;

statement ok
SELECT metric_scenario() FROM fin.priced;

query TTTT
SELECT scenario, applicable, code, (reason) IS NOT NULL FROM scenario_points('promo_on');
----
promo_on	false	nothing_changed	true

query TT
SELECT lever, planned_from FROM scenario_levers('promo_on');
----
priced.promo	held: the history is too short: 6 periods are needed, 3 are loaded

# a metric whose levers no scenario sets stores no scenario
statement ok
SELECT metric_scenario() FROM fin.sales;

query I
SELECT count(*) FROM scenario_points(NULL) WHERE metric = 'sales';
----
0

# --- a dataset where nothing can be estimated: four months of history, and a scenario whose only period is loaded

statement ok
DECLARE DATASET thin SET (purpose: 'too short');

statement ok
USE thin;

statement ok
CREATE TABLE thin.visits_raw AS
  SELECT (DATE '2025-01-01' + INTERVAL (m) MONTH)::DATE AS month, (100 + m)::DOUBLE AS n, 9.0 + m AS price FROM range(4) r(m);

statement ok
DECLARE ASPECT visits WITH $${"title": "Visits"}$$ AS VIEW;

statement ok
GLOSS visits ON thin AS $${"sql": "SELECT month AS period, n AS value, price FROM thin.visits_raw"}$$;

statement ok
GLOSS role ON visits.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON visits.value AS $${"value": "measure"}$$;

statement ok
SELECT temporal() FROM visits.period;

statement ok
GLOSS additivity ON visits.value AS $${"value": "additive"}$$;

statement ok
GLOSS lever ON visits.price AS $${"value": true, "basis": "the ticket price"}$$;

statement ok
DECLARE ASPECT cheaper WITH $${"title": "Cheaper in February", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

statement ok
GLOSS cheaper ON thin AS $${"levers": [{"column": "visits.price", "factor": {"2025-02": 0.9}, "basis": "a price cut"}]}$$;

# a scenario declared for another dataset is none of this one's
query T
SELECT scenario FROM scenarios() WHERE annotated;
----
cheaper

query TT
SELECT applicable, (reason) IS NOT NULL FROM scenario_request();
----
false	true

statement ok
SELECT metric_scenario() FROM thin.visits;

query TT
SELECT applicable, code FROM scenario_points('cheaper');
----
false	NULL

# a backtest the service scored no month of is no green: its test has no result, and no row of view_tests()
statement ok
SELECT metric_ranges() FROM thin;

query I
SELECT count(*) FROM TESTS() WHERE test = 'range_test';
----
0

query I
SELECT count(*) FROM view_tests() WHERE test = 'range_test';
----
0

# --- a metric served by year has no monthly series: its row says so and the backtest leaves it out

statement ok
USE fin;

statement ok
DECLARE ASPECT spend_by_year WITH $${"title": "Spend by year"}$$ AS VIEW;

statement ok
GLOSS spend_by_year ON fin AS $${"sql": "SELECT booked AS period, amount AS value FROM fin.ledger"}$$;

statement ok
GLOSS role ON spend_by_year.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON spend_by_year.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON spend_by_year.value AS $${"value": "additive"}$$;

statement ok
GLOSS time_grains ON spend_by_year.period AS $${"floor": "year"}$$;

query I
SELECT count(*) FROM range_request() WHERE metric = 'ledger_rows';
----
0

query TIT
SELECT r.applicable, r.months, coalesce(r.reason, '') <> '' FROM range_request() r WHERE r.metric = 'spend_by_year';
----
false	0	true

# --- a series that ends inside its last period: the backtest and the forecast leave it out alike

statement ok
GLOSS time_grains ON spend.period AS $${"floor": "month"}$$;

query TT
SELECT (SELECT max(period)::DATE FROM metric_series() WHERE metric = 'spend' AND dimension = ''),
       (SELECT origin::DATE FROM forecast_request() WHERE metric = 'spend');
----
2025-02-01	2025-01-01
