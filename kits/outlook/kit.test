plan_not_named

statement error
SELECT * FROM metric_series(world := 'plan', plan := 'nothing');
----
unknown_plan

statement error
SELECT * FROM metric_series(world := 'plan', plan := 'sales');
----
not_a_plan

statement error
SELECT * FROM metric_series(world := 'dream');
----
unknown_world

# plan_points(): the year first — whole, begun, not complete: the actual to date plus the year to go gives its range; then the months,
# loaded through the origin with their variance, the rest against their own step's range
query TTTRRRRRRTTRT
SELECT grain, label, period::DATE, value, actual, variance, low, expected, high, planned, covers, held_80, origin
FROM plan_points() WHERE plan = 'sales_budget' AND (grain = 'year' OR label IN ('2025-01', '2025-02', '2025-03', '2025-04', '2025-12'))
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
year	2025	2025-01-01	2120.0	141.0	NULL	1141.0	1241.0	1541.0	above	NULL	0.79	2025-02-01
month	2025-01	2025-01-01	120.0	124.0	4.0	NULL	NULL	NULL	complete	NULL	NULL	NULL
month	2025-02	2025-02-01	10.0	17.0	7.0	NULL	NULL	NULL	complete	NULL	NULL	NULL
month	2025-03	2025-03-01	90.0	NULL	NULL	80.0	100.0	120.0	inside	NULL	0.8	2025-02-01
month	2025-04	2025-04-01	200.0	NULL	NULL	80.0	100.0	120.0	above	NULL	0.8	2025-02-01
month	2025-12	2025-12-01	1000.0	NULL	NULL	80.0	100.0	120.0	above	NULL	NULL	2025-02-01

query I
SELECT count(*) FROM plan_points() WHERE plan = 'sales_budget';
----
13

# --- the comparison is stored on the plan: listed in measurements_to_run on its row until one exists, measured over it, tested; the reads use it
query T
SELECT measurements_to_run FROM view_summary() WHERE view = 'sales_budget';
----
[metric_plan over fin.sales_budget]

