SELECT current FROM TESTS() WHERE test = 'plan_test';
----
false

statement ok
SELECT metric_plan() FROM fin.sales_budget;

query IT
SELECT count(*), bool_and(current) FROM measurements_history m, TESTS() a WHERE m.function = 'metric_plan' AND a.test = 'plan_test';
----
