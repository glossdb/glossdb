statement ok
CREATE OR REPLACE MACRO main.service(path, body) AS (CASE
  WHEN path = '/whatif' AND (SELECT coalesce(bool_or(p1 IS DISTINCT FROM s1 OR p2 IS DISTINCT FROM s2), false) FROM (
         SELECT max(v1) FILTER (WHERE st = 'plan') AS p1, max(v1) FILTER (WHERE st = 'scenario') AS s1,
                max(v2) FILTER (WHERE st = 'plan') AS p2, max(v2) FILTER (WHERE st = 'scenario') AS s2
         FROM (SELECT unnest(json_extract(body, '$.table.period')::VARCHAR[]) AS period, unnest(json_extract(body, '$.table.status')::VARCHAR[]) AS st,
                      unnest(json_extract(body, '$.table."priced.price"')::DOUBLE[]) AS v1, unnest(json_extract(body, '$.table."priced.promo"')::DOUBLE[]) AS v2)
