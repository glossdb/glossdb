[]

query TTTTI
SELECT plan, metric, plan_grain, forecast_run = (SELECT max(begin_snapshot) FROM measurements WHERE function = 'metric_forecast'), count(*)
FROM plan_stored() GROUP BY ALL;
----
sales_budget	sales	month	true	13

query TTR
SELECT label, planned, value FROM plan_stored() WHERE planned IN ('below', 'above')
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
2025	above	2120.0
2025-04	above	200.0
2025-12	above	1000.0

query TTTR
SELECT subject, test, state, round(score, 2) FROM TESTS() WHERE test = 'plan_test';
