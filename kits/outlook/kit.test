# --- a plan is compared with the actual only where the actuals cover the period: hires begins in October 2024,
# a plan for the whole of 2024 has no actual for the year or for September, and one for October

statement ok
CREATE TABLE fin.hires_budget AS
  SELECT (DATE '2024-01-01' + INTERVAL (m) MONTH)::DATE AS month, 30.0 AS planned FROM range(12) r(m);

statement ok
DECLARE ASPECT hires_plan WITH $${"title": "Hiring plan", "x-kind": "plan", "x-plan-of": "hires"}$$ AS VIEW;

statement ok
GLOSS hires_plan ON fin AS $${"sql": "SELECT month AS period, planned AS value FROM fin.hires_budget"}$$;

query TTRRRT
SELECT grain, label, value, actual, variance, planned FROM plan_points()
WHERE plan = 'hires_plan' AND (grain = 'year' OR label IN ('2024-09', '2024-10'))
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
year	2024	360.0	NULL	NULL	not_covered
month	2024-09	30.0	NULL	NULL	not_covered
month	2024-10	30.0	31.0	1.0	complete

