# --- one forecast per metric: a metric defined, annotated and loaded beside it leaves sales's forecast current

statement ok
CREATE TABLE fin.counts AS SELECT (DATE '2024-01-01' + INTERVAL (m) MONTH)::DATE AS month, (10 + m)::DOUBLE AS n FROM range(13) r(m);

statement ok
DECLARE ASPECT balance WITH $${"title": "Balance"}$$ AS VIEW;

statement ok
GLOSS balance ON fin AS $${"sql": "SELECT month AS period, n AS value FROM fin.counts"}$$;

statement ok
GLOSS role ON balance.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON balance.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON balance.value AS $${"value": "semi-additive"}$$;

