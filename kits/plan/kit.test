CREATE OR REPLACE MACRO main.service(path, body) AS main.service_stub(path, body);

statement ok
SELECT metric_forecast() FROM fin.sales;

# the year: begun, not complete: the actual to date plus the year to go gives its range; the months against their
# own step's range
query TTRRRRRRTRT
SELECT grain, label, value, actual, variance, low, expected, high, planned, coverage_80, origin
FROM plan_points() WHERE plan = 'sales_budget' AND (grain = 'year' OR label IN ('2025-02', '2025-03', '2025-04', '2025-12'))
ORDER BY CASE grain WHEN 'year' THEN 0 ELSE 1 END, period;
----
year	2025	2120.0	138.0	NULL	1138.0	1238.0	1538.0	above	0.79	2025-02-01
month	2025-02	10.0	14.0	4.0	NULL	NULL	NULL	complete	NULL	NULL
month	2025-03	90.0	NULL	NULL	80.0	100.0	120.0	inside	0.8	2025-02-01
month	2025-04	200.0	NULL	NULL	80.0	100.0	120.0	above	0.8	2025-02-01
month	2025-12	1000.0	NULL	NULL	80.0	100.0	120.0	above	0.75	2025-02-01

# the stored comparison read the forecast on its metric: out of date now, and run again it is red with the
# finding of the year outside the range and the fix that records the plan again
query TT
SELECT DISTINCT asset, what FROM glossql_outdated() WHERE function = 'metric_plan' AND subject = 'fin.sales_budget';
----
fin.sales	result metric_forecast

statement ok
SELECT metric_plan() FROM fin.sales_budget;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test(), plan_test(), range_test() FROM fin;

query TT
SELECT starts_with(evidence->>'finding', 'sales_budget is 2120.0 at 2025, above'), contains(evidence->>'fix', 'GLOSS sales_budget ON fin AS $${"sql"')
FROM view_tests() WHERE test = 'plan_test' AND view = 'sales_budget';
----
true	true

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test(), plan_test(), range_test() FROM fin;

query TTR
SELECT subject, state, round(score, 2) FROM TESTS() WHERE test = 'plan_test';
----
fin.sales_budget	red	0.27

# the forecast series beside the plan in the chart
query TI
SELECT world, count(*) FROM world_series('month') WHERE metric = 'sales' GROUP BY ALL ORDER BY ALL;
----
forecast	12
plan	12

# a forecast of another metric leaves the plan current: it reads the forecast of its own metric
statement ok
SELECT metric_forecast() FROM fin.hires;

query I
SELECT count(*) FROM glossql_outdated() WHERE function = 'metric_plan' AND subject = 'fin.sales_budget';
----
0

# a load the comparison reads owes it again
statement ok
INSERT INTO fin.ledger VALUES (DATE '2025-02-05', 2.0);

statement ok
