query TTTT
SELECT evidence->>'forecast_code', (evidence->>'forecast_error') IS NOT NULL,
       contains(evidence->>'fix', 'SELECT metric_forecast() FROM fin.sales;'), contains(evidence->>'fix', 'SELECT metric_plan() FROM fin.sales_budget;')
FROM view_tests() WHERE test = 'plan_test' AND view = 'sales_budget';
----
service_failed	true	true	true

