# name: kits/core/kit.test
# description: the core kit — the workspace's own vocabulary, the review decision and the app aspects, and the interface's reads over the catalog; run again, it holds
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_core_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{KITS}/core/kit.sql');

query TTTTTTT
SELECT fmt_number(21205673.3), fmt_number(999.6), fmt_number(12.345), fmt_number(0.001), fmt_number(0.00001), fmt_number(0), fmt_number(NULL);
----
21,205,673	1,000	12.3	0.001	0.00001	0	NULL

query TTT
SELECT fmt_change(12.34), fmt_change(-0.04), fmt_change(NULL);
----
+12.3%	-0.04%	NULL

query I
SELECT count(*) FROM aspects WHERE name IN ('recipe_change', 'review_decision', 'app', 'app_page', 'app_frame', 'app_spec', 'app_release');
----
7

query I
SELECT count(*) FROM open_questions;
----
0

query I
SELECT count(*) FROM review_decisions;
----
0

# the same text again, as the opener runs it at every start-up: the kit holds, nothing runs
query TT
FROM glossql_kit('{KITS}/core/kit.sql');
----
core	current

query I
SELECT count(*) FROM kits WHERE name = 'core';
----
1

# --- a table or column test is open on each asset a metric reads, where its WHEN holds, until the asset has a value ---

statement ok
DECLARE DATASET shop SET (purpose: 'tests in use');

statement ok
CREATE TABLE shop.orders AS SELECT 1 AS id, 9.5 AS amount, 2 AS qty;

statement ok
CREATE TABLE shop.notes AS SELECT 1 AS id, 'x' AS note;

statement ok
DECLARE ASPECT kind_of WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE ASPECT money_unit WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN WHEN kind_of = 'measure';

statement ok
DECLARE TEST money_unit_test ON money_unit BY (AGENT, HUMAN);

statement ok
DECLARE ASPECT about WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON TABLE, COLUMN;

statement ok
DECLARE TEST about_test ON about BY (AGENT, HUMAN);

statement ok
USE shop;

statement ok
GLOSS kind_of ON orders.amount AS $${"value": "measure"}$$;

statement ok
GLOSS kind_of ON orders.qty AS $${"value": "measure"}$$;

# measures exist, but no metric reads anything: no test is open
query I
SELECT open FROM workspace_status WHERE surface = 'validations';
----
0

statement ok
DECLARE ASPECT sales WITH $${"title": "Sales"}$$ AS VIEW;

statement ok
GLOSS sales ON shop AS $${"sql": "SELECT id AS period, amount AS value FROM shop.orders"}$$;

# the metric reads orders and its amount: the unit is open on amount, not on qty, which no metric reads;
# the table property is open on orders, not on notes
query I
SELECT open FROM workspace_status WHERE surface = 'validations';
----
2

statement ok
GLOSS money_unit ON orders.amount AS $${"value": "EUR"}$$;

query I
SELECT open FROM workspace_status WHERE surface = 'validations';
----
1

statement ok
GLOSS about ON orders AS $${"value": "one row per order"}$$;

query I
SELECT open FROM workspace_status WHERE surface = 'validations';
----
0
