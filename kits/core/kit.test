# name: kits/core/kit.test
# description: the core kit — the workspace's own vocabulary, the review decision and the app aspects, and the interface's reads over the catalog; run again, it holds
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_core_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{KITS}/core/kit.sql');

query TTTTTTT
SELECT fmt_number(21205673.3), fmt_number(999.6), fmt_number(12.345), fmt_number(0.001), fmt_number(0.00001), fmt_number(0), fmt_number(NULL);
----
21,205,673	1,000	12.3	0.001	0.00001	0	NULL

query TTT
SELECT fmt_change(12.34), fmt_change(-0.04), fmt_change(NULL);
----
+12.3%	-0.04%	NULL

# the CSV reader takes the list of null markers as its nullstr
query II
SELECT list_contains(null_markers(), 'N/A'), list_contains(null_markers(), '-');
----
true	false

query I
SELECT count(*) FROM aspects WHERE name IN ('recipe_change', 'review_decision', 'app', 'app_page', 'app_frame', 'app_spec', 'app_release');
----
7

query I
SELECT count(*) FROM open_questions;
----
0

query I
SELECT count(*) FROM review_decisions;
----
0

# the same text again, as the opener runs it at every start-up: the kit holds, nothing runs
query TT
FROM glossql_kit('{KITS}/core/kit.sql');
----
core	current

query I
SELECT count(*) FROM kits WHERE name = 'core';
----
1

# --- a table or column test is open on each asset a metric reads, where its WHEN holds, until the asset has a value ---

statement ok
DECLARE DATASET shop SET (purpose: 'tests in use');

statement ok
CREATE TABLE shop.orders AS SELECT 1 AS id, 9.5 AS amount, 2 AS qty;

statement ok
CREATE TABLE shop.notes AS SELECT 1 AS id, 'x' AS note;

statement ok
DECLARE ASPECT kind_of WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE ASPECT money_unit WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON COLUMN WHEN kind_of = 'measure';

statement ok
DECLARE TEST money_unit_test ON money_unit BY (AGENT, HUMAN);

statement ok
DECLARE ASPECT about WITH $${"type": "object", "properties": {"value": {"type": "string"}}}$$ AS FACT ON TABLE, COLUMN;

statement ok
DECLARE TEST about_test ON about BY (AGENT, HUMAN);

statement ok
USE shop;

statement ok
GLOSS kind_of ON orders.amount AS $${"value": "measure"}$$;

statement ok
GLOSS kind_of ON orders.qty AS $${"value": "measure"}$$;

# measures exist, but no metric reads anything: no test is open
query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
0

statement ok
DECLARE ASPECT sales WITH $${"title": "Sales"}$$ AS VIEW;

statement ok
GLOSS sales ON shop AS $${"sql": "SELECT id AS period, amount AS value FROM shop.orders"}$$;

# the metric reads orders and its amount: the unit is open on amount, not on qty, which no metric reads;
# the table property is open on orders, not on notes
query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
2

statement ok
GLOSS money_unit ON orders.amount AS $${"value": "EUR"}$$;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
1

statement ok
GLOSS about ON orders AS $${"value": "one row per order"}$$;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
0

# --- a kit's check on a view is open on a metric until its result is stored there, and not on the tables the
# metric reads

statement ok
DECLARE ASPECT sales_check WITH $${"type": "object", "x-subject": "view", "properties": {"breach_rate": {"type": ["number", "null"]}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION sales_check FOR GLOBAL AS $$SELECT 0.0 AS breach_rate, 'none' AS finding$$ RETURNS sales_check;

statement ok
DECLARE FUNCTION all_green FOR GLOBAL AS $$SELECT subject, 'green' AS state, 0.0 AS score FROM annotations GROUP BY subject$$;

statement ok
DECLARE TEST sales_check_test ON sales_check BY (AGENT, HUMAN) DETECTOR all_green;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
1

statement ok
SELECT sales_check() FROM shop.sales;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
0

# --- a test of the team's own is open where its expectation is annotated, until its check has run there; the
# other tables and columns the metric reads do not count

statement ok
DECLARE ASPECT amount_positive WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION amount_positive_check FOR shop AS $$SELECT count(*) FILTER (WHERE amount <= 0) / greatest(count(*), 1)::DOUBLE AS breach_rate, NULL::VARCHAR AS finding FROM shop.orders$$ RETURNS amount_positive;

statement ok
DECLARE TEST amount_positive_test ON amount_positive BY (AGENT, HUMAN) DETECTOR all_green;

query IT
SELECT (SELECT open FROM workspace_status WHERE area = 'tests'), (SELECT string_agg(name, ',' ORDER BY name) FROM tested_properties());
----
0	amount_positive

statement ok
GLOSS amount_positive ON orders.amount AS $${"outcome": "an amount is above zero", "tolerance": 0.0, "basis": "an order has a price"}$$;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
1

statement ok
SELECT amount_positive_check() FROM orders.amount;

query I
SELECT open FROM workspace_status WHERE area = 'tests';
----
0
