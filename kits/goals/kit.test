statement ok
DECLARE ASPECT staffing WITH $${"title": "Staffing"}$$ AS VIEW;

statement ok
GLOSS staffing ON ops AS $${"sql": "SELECT month, staff AS value FROM ops.orders_raw"}$$;

query TTTTT
SELECT level, kind, asset, state, statement FROM next WHERE contains(statement, 'metric_');
