# a plan is declared and defined: nobody compared it yet, so it is no row; the ranges read the dataset's metrics and
# the forecast its metric, and a plan is neither: they stay current
statement ok
DECLARE ASPECT orders_target WITH $${"title": "Orders target", "x-kind": "plan", "x-plan-of": "orders"}$$ AS VIEW;

statement ok
GLOSS orders_target ON ops AS $${"sql": "SELECT month, orders * 1.1 AS value FROM ops.orders_raw"}$$;

statement ok
GLOSS role ON orders_target.value AS $${"value": "measure"}$$;

query I
SELECT count(*) FROM glossql_outdated() WHERE function LIKE 'metric_%';
----
0

statement ok
SELECT metric_plan() FROM ops.orders_target;

query TT
SELECT view, subject FROM view_tests() WHERE test = 'plan_test';
----
orders_target	ops.orders_target

query I
SELECT count(*) FROM next WHERE contains(statement, 'metric_');
----
0

# a metric declared beside them: the ranges read every metric and are out of date; the forecast of orders, and the
