# with no table in the dataset, the list has one row: a source to connect and a table to load
query TTT
SELECT step, state, who FROM next;
----
integrate	missing	agent

query TT
FROM glossql_kit('{KITS}/goals/kit.sql');
----
goals	current

query I
SELECT count(*) FROM kits;
----
6

# --- the preview measurements in `next`: listed where the dataset needs them, due again when what they read
# changed and only then; the model service is stood in for

statement ok
COPY (SELECT (DATE '2023-01-01' + INTERVAL (m) MONTH)::DATE AS month, 100.0 + m AS orders, 10.0 + m % 3 AS price, 5 AS staff
      FROM range(30) r(m)) TO '{TEST_DIR}/orders.csv' (HEADER);

statement ok
DECLARE DATASET ops SET (purpose: 'orders per month');

statement ok
USE ops;

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE orders_raw ON ops FROM erp AS $$SELECT CAST(month AS DATE) AS month, CAST(orders AS DOUBLE) AS orders, CAST(price AS DOUBLE) AS price, CAST(staff AS INTEGER) AS staff FROM read_csv('orders.csv')$$;

# a table is loaded and no view reads it: the one row is still to define a view; nothing is asked about the table
query TTTT
SELECT step, state, who, statement <> '' FROM next;
----
integrate	missing	agent	true

statement ok
DECLARE ASPECT orders WITH $${"title": "Orders"}$$ AS VIEW;

statement ok
GLOSS orders ON ops AS $${"sql": "SELECT month, orders AS value, price FROM ops.orders_raw"}$$;

statement ok
GLOSS role ON orders.month AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON orders.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON orders.value AS $${"value": "additive"}$$;

statement ok
GLOSS time_grains ON orders.month AS $${"floor": "month"}$$;

statement ok
GLOSS meaning ON ops.orders AS $${"value": "orders taken per month"}$$;

query TT
SELECT applicable, floor FROM view_summary() WHERE view = 'orders';
----
true	month

# the view's column price has no role: the summary row and `next` ask for it with the same statement, on the
# view's own column
query TT
SELECT contains(s.missing[1], 'ops.orders.price'), contains(n.statement, s.missing[1])
FROM (SELECT missing FROM view_summary() WHERE view = 'orders') s,
     (SELECT statement FROM next WHERE step = 'describe' AND asset = 'ops.orders' AND state = 'missing') n;
----
true	true

# no model service is named: no preview measurement is asked for
query I
SELECT count(*) FROM next WHERE asset = 'ops' AND statement LIKE 'SELECT metric_%';
----
0

statement ok
SET GLOBAL glossql_service_url = 'http://model.test';

statement ok
CREATE OR REPLACE MACRO main.service(path, body) AS CASE WHEN path = '/whatif' THEN '{"table":{"member":["orders","orders"],"period":["2025-08-01","2025-08-01"],"column":["value","value"],"status":["plan","scenario"],"level":[0.5,0.5],"value":[130,120]},"answer":{"service":"model","version":"test","errors":[],"parts":[]}}'::JSON WHEN json_extract(body, '$.spec.origins') IS NOT NULL THEN '{"table":{"member":["orders","orders","orders","orders","orders"],"period":["2025-06","2025-06","2025-06","2025-06","2025-06"],"level":[0.05,0.1,0.5,0.9,0.95],"value":[100,110,120,130,140],"actual":[129,129,129,129,129],"pit":[0.7,0.7,0.7,0.7,0.7]},"answer":{"service":"model","version":"test","errors":[],"coverage":[],"backtest":{"score":0.4,"state":"green","threshold":0.98,"members":[{"member":"orders","column":"value","backtested":1,"held_80":1.0,"held_90":1.0,"newest":{"origin":"2025-05","period":"2025-06","pit":0.7,"displacement":0.4,"withheld":null}}]}}}'::JSON ELSE '{"table":{"member":["orders","orders","orders","orders","orders"],"step":[1,1,1,1,1],"span":[null,null,null,null,null],"period":["2025-08-01","2025-08-01","2025-08-01","2025-08-01","2025-08-01"],"level":[0.05,0.1,0.5,0.9,0.95],"value":[100,110,120,130,140]},"answer":{"service":"model","version":"test","errors":[],"coverage":[]}}'::JSON END;

statement ok
CREATE OR REPLACE MACRO main.service_soft(path, body) AS '{"error": "refused"}'::JSON;

# a metric is served: the expected ranges are due; no plan and no scenario, so no forecast
query TTT
SELECT asset, state, statement FROM next WHERE asset = 'ops' AND statement LIKE 'SELECT metric_%';
----
ops	not_run	SELECT metric_ranges() FROM ops;

# the server does not run it after a write: results_due() does not list it, and `next` does
query II
SELECT (SELECT count(*) FROM results_due() WHERE function = 'metric_ranges'),
       (SELECT count(*) FROM next WHERE statement = 'SELECT metric_ranges() FROM ops;');
----
0	1

statement ok
SELECT metric_ranges() FROM ops;

query I
SELECT count(*) FROM next WHERE asset = 'ops' AND statement LIKE 'SELECT metric_%';
----
0

# a plan is declared and defined, and a column the metric does not read is annotated: the catalog moved, so the
# stale rule marks the stored ranges, and nothing they read changed, so they are not due; the plan makes the forecast due
statement ok
DECLARE ASPECT orders_target WITH $${"title": "Orders target", "x-kind": "plan", "x-plan-of": "orders"}$$ AS VIEW;

statement ok
GLOSS orders_target ON ops AS $${"sql": "SELECT month, orders * 1.1 AS value FROM ops.orders_raw"}$$;

statement ok
GLOSS meaning ON ops.orders_raw.staff AS $${"value": "people on shift"}$$;

query T
SELECT current FROM TESTS() WHERE test = 'range_test';
----
false

query TTT
SELECT name, stored, due FROM outlook_measurements() ORDER BY name;
----
metric_forecast	false	true
metric_ranges	true	false

query T
SELECT statement FROM next WHERE asset = 'ops' AND statement LIKE 'SELECT metric_%';
----
SELECT metric_forecast() FROM ops;

statement ok
SELECT metric_forecast() FROM ops;

statement ok
SELECT metric_plan() FROM ops.orders_target;

# an assumption added to the plan and one added to the metric leave the SQL as it is: nothing is due
statement ok
GLOSS orders_target ON ops AS $${"sql": "SELECT month, orders * 1.1 AS value FROM ops.orders_raw", "assumptions": [{"dimension": "definition", "key": "target", "assumption": "the target is ten percent over the orders", "basis": "the sales plan", "confidence": 0.7}]}$$;

statement ok
GLOSS orders ON ops AS $${"sql": "SELECT month, orders AS value, price FROM ops.orders_raw", "assumptions": [{"dimension": "definition", "key": "taken", "assumption": "an order counts in the month it is taken", "basis": "the order date", "confidence": 0.7}]}$$;

query I
SELECT count(*) FROM outlook_measurements() WHERE due;
----
0

query I
SELECT count(*) FROM next WHERE asset = 'ops' AND statement LIKE 'SELECT metric_%';
----
0

# the table is loaded again with a month more: the ranges and the forecast read it, and are due
statement ok
COPY (SELECT (DATE '2023-01-01' + INTERVAL (m) MONTH)::DATE AS month, 100.0 + m AS orders, 10.0 + m % 3 AS price, 5 AS staff
      FROM range(31) r(m)) TO '{TEST_DIR}/orders.csv' (HEADER);

statement ok
DECLARE RECIPE orders_raw ON ops FROM erp AS $$SELECT CAST(month AS DATE) AS month, CAST(orders AS DOUBLE) AS orders, CAST(price AS DOUBLE) AS price, CAST(staff AS INTEGER) AS staff FROM read_csv('orders.csv') WHERE orders > 0$$;

query TT
SELECT name, due FROM outlook_measurements() ORDER BY name;
----
metric_forecast	true
metric_ranges	true

query TT
SELECT table_name, starts_with(cause, 'loaded again: ') FROM load_changes();
----
ops.orders_raw	true

statement ok
SELECT metric_ranges() FROM ops;

statement ok
SELECT metric_forecast() FROM ops;

query I
SELECT count(*) FROM outlook_measurements() WHERE due;
----
0

# the metric's SQL changes: due again
statement ok
GLOSS orders ON ops AS $${"sql": "SELECT month, orders AS value, price FROM ops.orders_raw WHERE month >= DATE '2023-02-01'"}$$;

query TT
SELECT name, due FROM outlook_measurements() ORDER BY name;
----
metric_forecast	true
metric_ranges	true

# the annotation on the view is outdated, and its row says what changed: the definition, recorded again
query TT
SELECT state, cause <> '' FROM next WHERE step = 'describe' AND asset = 'ops.orders' AND state = 'stale';
----
stale	true

statement ok
SELECT metric_ranges() FROM ops;

statement ok
SELECT metric_forecast() FROM ops;

# a scenario is annotated: its estimate is due, and the ranges and the forecast are not
statement ok
GLOSS lever ON orders.price AS $${"value": true, "basis": "the list price"}$$;

statement ok
DECLARE ASPECT price_cut WITH $${"title": "Price cut", "x-kind": "scenario", "type": "object", "required": ["levers"], "properties": {"levers": {"type": "array"}}}$$ AS FACT ON DATASET;

statement ok
GLOSS price_cut ON ops AS $${"levers": [{"column": "orders.price", "factor": {"2025-08": 0.9}, "basis": "a cut in August"}]}$$;

query TTT
SELECT name, stored, due FROM outlook_measurements() ORDER BY name;
----
metric_forecast	true	false
metric_ranges	true	false
metric_scenario	false	true

statement ok
SELECT metric_scenario() FROM ops;

query TT
SELECT state, current FROM TESTS() WHERE test = 'scenario_test';
----
green	true

# the scenario's factor changes: its own estimate is due, alone
statement ok
GLOSS price_cut ON ops AS $${"levers": [{"column": "orders.price", "factor": {"2025-08": 0.8}, "basis": "a deeper cut in August"}]}$$;

query T
SELECT name FROM outlook_measurements() WHERE due;
----
metric_scenario

# a scenario whose only period is loaded already is estimated for nothing: its test has no result, and `next` asks
# its author for a period ahead, with the scenario's statement
statement ok
GLOSS price_cut ON ops AS $${"levers": [{"column": "orders.price", "factor": {"2025-01": 0.9}, "basis": "a cut in January"}]}$$;

statement ok
SELECT metric_scenario() FROM ops;

query I
SELECT count(*) FROM TESTS() WHERE test = 'scenario_test';
----
0

query TTT
SELECT step, asset, state FROM next WHERE contains(statement, 'GLOSS price_cut ON ops');
----
test	ops.orders	not_run

# --- a test of one's own on a column a view reads. The property holds the expectation, annotated on the one
# column: `next` does not ask for it on the other assets the views read. Its row in `next` carries the check's
# finding, the check to run again and the annotation that records a rate a person accepts, with the
# expectation's own words kept; view_tests() names the check as `run`. The count of open tests in
# workspace_status is compared with the count before the test was declared

statement ok
CREATE TABLE memory.main.open_before AS SELECT open FROM workspace_status WHERE area = 'tests';

statement ok
DECLARE ASPECT price_rule WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION price_check FOR ops AS $$SELECT count(*) FILTER (WHERE price <= 11) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) FILTER (WHERE price <= 11) || ' rows are priced at 11 or under' AS finding FROM ops.orders_raw$$ RETURNS price_rule;

statement ok
DECLARE TEST price_test ON price_rule BY (AGENT, HUMAN) DETECTOR rate_tolerance;

# declared and set nowhere: nothing asks for it
query II
SELECT (SELECT count(*) FROM next WHERE contains(statement, 'price_rule')),
       (SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests');
----
0	0

statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.0, "basis": "the price list starts at 12"}$$;

# set on the one column and not run: the test waits there, with the check as its statement, and counts as open once
query TTT
SELECT step, asset, state FROM next WHERE contains(statement, 'price_rule') OR contains(statement, 'price_check');
----
test	ops.orders_raw.price	yellow

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
1

statement ok
SELECT price_check() FROM ops.orders_raw.price;

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
0

query TT
SELECT state, run FROM view_tests() WHERE test = 'price_test' AND view = 'orders';
----
red	SELECT price_check() FROM ops.orders_raw.price

query TTTTT
SELECT state, starts_with(open, 'price_test: ') AND contains(open, 'rows are priced'),
       contains(statement, 'SELECT price_check() FROM ops.orders_raw.price;'),
       contains(statement, 'GLOSS price_rule ON ops.orders_raw.price AS') AND contains(statement, '"tolerance":'),
       contains(statement, '"outcome":"a price is above 11"')
FROM next WHERE step = 'test' AND asset = 'ops.orders_raw.price' AND for_view = 'orders';
----
red	true	true	true	true

# the expectation is asked for on no other asset: no row of `next` names it as missing
query I
SELECT count(*) FROM next WHERE step = 'describe' AND contains(statement, 'price_rule');
----
0

# a tolerance above the measured rate, with its basis, turns the test green and closes the row
statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.7, "basis": "sales lead: the two low price points are promotions"}$$;

query T
SELECT state FROM view_tests() WHERE test = 'price_test' AND view = 'orders';
----
green

query I
SELECT count(*) FROM next WHERE step = 'test' AND asset = 'ops.orders_raw.price';
----
0

# a test on a measurement is set where its check ran, and is asked for nowhere else
statement ok
DECLARE ASPECT staff_rule WITH $${"type": "object", "properties": {"breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION staff_check FOR ops AS $$SELECT count(*) FILTER (WHERE staff < 1) / greatest(count(*), 1)::DOUBLE AS breach_rate, NULL::VARCHAR AS finding FROM ops.orders_raw$$ RETURNS staff_rule;

statement ok
DECLARE TEST staff_test ON staff_rule DETECTOR rate_tolerance THRESHOLD 0.0;

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
0

# --- each assumption that waits for a person is a row of `next`, as open_questions counts them; `entity` is
# asked on a table view, with its grain, and not on a metric

statement ok
DECLARE ASPECT order_list WITH $${"title": "Orders, listed", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS order_list ON ops AS $${"sql": "SELECT month, orders FROM ops.orders_raw", "assumptions": [{"dimension": "scope", "key": "all-months", "assumption": "every month is kept", "basis": "the rows", "confidence": 0.7}, {"dimension": "scope", "key": "staff-left-out", "assumption": "staff is left out", "basis": "not asked for", "confidence": 0.6}]}$$;

query II
SELECT (SELECT count(*) FROM next WHERE who = 'person' AND asset = 'ops.order_list'),
       (SELECT count(*) FROM open_questions WHERE aspect = 'order_list');
----
2	2

query II
SELECT count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.order_list AS') AND contains(statement, '"grain"')),
       count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.orders AS'))
FROM next WHERE step = 'describe';
----
1	0

# --- view_definitions: a metric's kind is measure; a view's meaning is the annotation on the view; a view
# with no formula has none

query TTT
SELECT kind, meaning, formula IS NULL FROM view_definitions WHERE name = 'orders';
----
measure	orders taken per month	true

query T
SELECT kind FROM view_definitions WHERE name = 'order_list';
----
relation

# --- every kind of view closes the row to define one, a stopped one does not. A test of one's own on a table view
# is set on the view: its row names the view, its check and the statement that accepts its rate, and the table view's
# own columns are asked to be described

statement ok
DECLARE DATASET side SET (purpose: 'views of every kind');

statement ok
USE side;

statement ok
CREATE TABLE side.ledger AS SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
  ['general', 'water', 'parks'][i % 3 + 1] AS fund FROM range(120) r(i);

statement ok
DECLARE ASPECT ledger_rows WITH $${"title": "Ledger rows", "x-kind": "scalar"}$$ AS VIEW;

statement ok
GLOSS ledger_rows ON side AS $${"sql": "SELECT count(*) AS value FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE step = 'integrate';
----
0

statement ok
GLOSS ledger_rows ON side AS $${"stopped": "the count is read elsewhere"}$$;

query TT
SELECT asset, state FROM next WHERE step = 'integrate';
----
side	missing

statement ok
DECLARE ASPECT ledger_clean WITH $${"title": "Ledger, cleaned", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS ledger_clean ON side AS $${"sql": "SELECT booked, amount, fund FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE step = 'integrate';
----
0

statement ok
DECLARE ASPECT fund_coded WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "rows": {"type": "integer"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION fund_coded_check FOR side AS $$SELECT count(*) FILTER (WHERE fund NOT IN ('general', 'water')) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) AS rows FROM side.ledger_clean$$ RETURNS fund_coded;

statement ok
DECLARE TEST fund_coded_test ON fund_coded BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS fund_coded ON ledger_clean AS $${"outcome": "each fund is in the code table", "tolerance": 0.0, "basis": "the code table lists every fund"}$$;

statement ok
SELECT fund_coded_check() FROM ledger_clean;

query TTTT
SELECT state, for_view, contains(statement, 'fund_coded_check()'), contains(statement, 'GLOSS fund_coded ON side.ledger_clean AS')
FROM next WHERE step = 'test' AND asset = 'side.ledger_clean';
----
red	ledger_clean	true	true

query II
SELECT (SELECT count(*) FROM next WHERE step = 'describe' AND contains(statement, 'fund_coded')),
       (SELECT count(*) FROM next WHERE step = 'describe' AND asset = 'side.ledger_clean' AND contains(statement, 'side.ledger_clean.fund'));
----
0	1

# --- a check that fails is stored with its error: not due again after a write it did not read, due again once what it read moves

statement ok
DECLARE ASPECT fund_named WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "rows": {"type": "integer"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION fund_named_check FOR side AS $$SELECT CASE WHEN count(*) FILTER (WHERE fund IS NULL) > 0 THEN error('fund_missing: a row names no fund') ELSE 0.0 END AS breach_rate, count(*) AS rows FROM side.ledger_clean$$ RETURNS fund_named;

statement ok
DECLARE TEST fund_named_test ON fund_named BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS fund_named ON ledger_clean AS $${"outcome": "every row names its fund", "tolerance": 0.0, "basis": "a booking without a fund cannot be reported"}$$;

statement ok
INSERT INTO side.ledger SELECT booked, amount, NULL FROM side.ledger LIMIT 1;

statement error
SELECT fund_named_check() FROM ledger_clean;
----
fund_missing

query TT
SELECT current, error IS NOT NULL FROM GLOSSARY(ledger_clean, all => true) WHERE aspect = 'fund_named' AND actor = 'function';
----
true	true

statement ok
CREATE TABLE side.unrelated AS SELECT 1 AS x;

query I
SELECT count(*) FROM results_due() WHERE function = 'fund_named';
----
0

statement ok
INSERT INTO side.ledger SELECT booked, amount, 'water' FROM side.ledger LIMIT 1;

query T
SELECT run FROM results_due() WHERE function = 'fund_named';
----
SELECT fund_named_check() FROM side.ledger_clean
