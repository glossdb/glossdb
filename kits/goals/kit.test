should	test	ops	stale	SELECT metric_ranges() FROM ops;

statement ok
GLOSS staffing ON ops AS $${"stopped": "not a metric of this test"}$$;

statement ok
SELECT metric_ranges() FROM ops;

# a change to the metric makes its forecast, the plan and the ranges out of date: the forecast's row is on the
