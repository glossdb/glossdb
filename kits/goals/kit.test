# name: kits/goals/kit.test
# description: the goals kit — what the server computes after a write (`results_due()`) and the work list `next`, its rows by level and kind of work, on the kits before it; run again, it holds
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_goals_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{KITS}/core/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/kpi/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/quality/kit.sql');

statement ok
FROM glossql_kit('{KITS}/views/kit.sql');

statement ok
FROM glossql_kit('{KITS}/goals/kit.sql');

query I
SELECT count(*) FROM results_due();
----
0

# with no table in the dataset, the list has one row: a source to connect and a table to load, which must be done
query TTTT
SELECT level, kind, state, who FROM next;
----
must	integrate	missing	agent

query TT
FROM glossql_kit('{KITS}/goals/kit.sql');
----
goals	current

# --- the levels. A table no view reads is described on request (could); with no view, one must be defined.
# A metric served: what its view reads is to be described (should)

statement ok
COPY (SELECT (DATE '2023-01-01' + INTERVAL (m) MONTH)::DATE AS month, 100.0 + m AS orders, 10.0 + m % 3 AS price, 5 AS staff
      FROM range(30) r(m)) TO '{TEST_DIR}/orders.csv' (HEADER);

statement ok
DECLARE DATASET ops SET (purpose: 'orders per month');

statement ok
USE ops;

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE orders_raw ON ops FROM erp AS $$SELECT CAST(month AS DATE) AS month, CAST(orders AS DOUBLE) AS orders, CAST(price AS DOUBLE) AS price, CAST(staff AS INTEGER) AS staff FROM read_csv('orders.csv')$$;

query TTTT
SELECT level, kind, asset, state FROM next;
----
must	integrate	ops	missing
could	describe	ops.orders_raw	missing

statement ok
GLOSS orders ON ops AS $${"kind": "metric", "sql": "SELECT month, orders AS value, price FROM ops.orders_raw"}$$;

statement ok
GLOSS role ON orders.month AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON orders.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON orders.value AS $${"value": "additive"}$$;

statement ok
GLOSS time_grains ON orders.month AS $${"floor": "month"}$$;

statement ok
GLOSS meaning ON ops.orders AS $${"value": "orders taken per month"}$$;

query TT
SELECT applicable, floor FROM view_summary() WHERE view = 'orders';
----
true	month

# every shipped measurement reads the data of its subject's dataset alone: no table named, and no dataset but
# the subject's (a read past the read functions is refused at the declaration)
query I
SELECT count(*)
FROM main.functions f, unnest(from_json(f.reads, '[{"kind": "VARCHAR", "read": "VARCHAR", "what": "VARCHAR", "where": "VARCHAR", "constant": "BOOLEAN"}]')) u(r)
WHERE f.returns IS NOT NULL AND f.declared_by LIKE 'kit:%'
  AND ((r.kind = 'data' AND r."where" IS NULL AND r.read NOT IN ('dataset_cells', 'subject_column', 'glossql_relationship_checks'))
       OR (r.kind = 'data' AND r.read IN ('dataset_cells', 'subject_column') AND NOT regexp_matches(r.what, '^[<$]')));
----
0

# --- a test of one's own on a column a view reads. The property holds the expectation, annotated on the one
# column: `next` does not ask for it on the other assets the views read. Its row in `next` carries the check's
# finding, the check to run again and the annotation that records a rate a person accepts, with the
# expectation's own words kept; view_tests() names the check as `run`

statement ok
DECLARE PROPERTY price_rule WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION price_check FOR ops AS $$SELECT count(*) FILTER (WHERE price <= 11) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) FILTER (WHERE price <= 11) || ' rows are priced at 11 or under' AS finding FROM ops.orders_raw$$ RETURNS price_rule;

statement ok
DECLARE TEST price_test ON price_rule BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.0, "basis": "the price list starts at 12"}$$;

statement ok
SELECT price_check() FROM ops.orders_raw.price;

query TTTTT
SELECT state, starts_with(open, 'price_test: ') AND contains(open, 'rows are priced'),
       contains(statement, 'SELECT price_check() FROM ops.orders_raw.price;'),
       contains(statement, 'GLOSS price_rule ON ops.orders_raw.price AS') AND contains(statement, '"tolerance":'),
       contains(statement, '"outcome":"a price is above 11"')
FROM next WHERE kind = 'test' AND asset = 'ops.orders_raw.price' AND for_view = 'orders';
----
red	true	true	true	true

# the expectation is asked for on no other asset: no row of `next` names it as missing
query I
SELECT count(*) FROM next WHERE kind = 'describe' AND contains(statement, 'price_rule');
----
0

# a tolerance above the measured rate, with its basis, turns the test green and closes the row
statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.7, "basis": "sales lead: the two low price points are promotions"}$$;

query T
SELECT state FROM view_tests() WHERE test = 'price_test' AND view = 'orders';
----
green

query I
SELECT count(*) FROM next WHERE kind = 'test' AND asset = 'ops.orders_raw.price';
----
0

# a property with no tolerance of its own: the rate is accepted by declaring the test again with it as threshold,
# and the statement handed keeps who may annotate the property
statement ok
DECLARE PROPERTY orders_rule WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION orders_check FOR ops AS $$SELECT 1.0::DOUBLE AS breach_rate, 'every row breaks it' AS finding FROM ops.orders_raw LIMIT 1$$ RETURNS orders_rule;

statement ok
DECLARE TEST orders_test ON orders_rule BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS orders_rule ON ops.orders_raw.orders AS $${"outcome": "no row has orders"}$$;

statement ok
SELECT orders_check() FROM ops.orders_raw.orders;

query I
SELECT count(*) FROM next WHERE kind = 'test' AND asset = 'ops.orders_raw.orders'
  AND contains(statement, 'DECLARE TEST orders_test ON orders_rule BY (AGENT, HUMAN) DETECTOR rate_tolerance THRESHOLD');
----
1

statement ok
DELETE FROM glossary WHERE property = 'orders_rule';

# a test on a measurement is set where its check ran, and is asked for nowhere else
statement ok
DECLARE PROPERTY staff_rule WITH $${"type": "object", "properties": {"breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION staff_check FOR ops AS $$SELECT count(*) FILTER (WHERE staff < 1) / greatest(count(*), 1)::DOUBLE AS breach_rate, NULL::VARCHAR AS finding FROM ops.orders_raw$$ RETURNS staff_rule;

statement ok
DECLARE TEST staff_test ON staff_rule DETECTOR rate_tolerance THRESHOLD 0.0;

# --- each assumption that waits for a person is a should row of `next`, as open_questions counts them; `entity` is
# asked on a table view, with its grain, and not on a metric

statement ok
GLOSS order_list ON ops AS $${"kind": "table", "sql": "SELECT month, orders FROM ops.orders_raw", "assumptions": [{"dimension": "scope", "key": "all-months", "assumption": "every month is kept", "basis": "the rows", "confidence": 0.7}, {"dimension": "scope", "key": "staff-left-out", "assumption": "staff is left out", "basis": "not asked for", "confidence": 0.6}]}$$;

query II
SELECT (SELECT count(*) FROM next WHERE who = 'person' AND asset = 'ops.order_list' AND level = 'should' AND kind = 'review'),
       (SELECT count(*) FROM open_questions WHERE property = 'order_list');
----
2	2

query II
SELECT count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.order_list AS') AND contains(statement, '"grain"')),
       count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.orders AS'))
FROM next WHERE kind = 'describe';
----
1	0

# --- every kind of view closes the row to define one, a stopped one does not. A test of one's own on a table view
# is set on the view: its row names the view, its check and the statement that accepts its rate, and the table view's
# own columns are asked to be described

statement ok
DECLARE DATASET side SET (purpose: 'views of every kind');

statement ok
USE side;

statement ok
CREATE TABLE side.ledger AS SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
  ['general', 'water', 'parks'][i % 3 + 1] AS fund FROM range(120) r(i);

statement ok
GLOSS ledger_rows ON side AS $${"kind": "value", "sql": "SELECT count(*) AS value FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE kind = 'integrate';
----
0

statement ok
GLOSS ledger_rows ON side AS $${"stopped": "the count is read elsewhere"}$$;

query TT
SELECT asset, state FROM next WHERE kind = 'integrate';
----
side	missing

statement ok
GLOSS ledger_clean ON side AS $${"kind": "table", "sql": "SELECT booked, amount, fund FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE kind = 'integrate';
----
0

statement ok
DECLARE PROPERTY fund_coded WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "rows": {"type": "integer"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION fund_coded_check FOR side AS $$SELECT count(*) FILTER (WHERE fund NOT IN ('general', 'water')) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) AS rows FROM side.ledger_clean$$ RETURNS fund_coded;

statement ok
DECLARE TEST fund_coded_test ON fund_coded BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS fund_coded ON ledger_clean AS $${"outcome": "each fund is in the code table", "tolerance": 0.0, "basis": "the code table lists every fund"}$$;

statement ok
SELECT fund_coded_check() FROM ledger_clean;

query TTTTT
SELECT level, state, for_view, contains(statement, 'fund_coded_check()'), contains(statement, 'GLOSS fund_coded ON side.ledger_clean AS')
FROM next WHERE kind = 'test' AND asset = 'side.ledger_clean' AND starts_with(open, 'fund_coded_test');
----
must	red	ledger_clean	true	true

query II
SELECT (SELECT count(*) FROM next WHERE kind = 'describe' AND contains(statement, 'fund_coded')),
       (SELECT count(*) FROM next WHERE kind = 'describe' AND asset = 'side.ledger_clean' AND contains(statement, 'side.ledger_clean.fund'));
----
0	1

statement ok
DECLARE DATASET grid SET (purpose: 'two metrics over one table');

statement ok
USE grid;

statement ok
CREATE TABLE grid.results AS SELECT DATE '2024-01-01' + (i % 40)::INTEGER AS date, i % 7 AS driver_id, (i % 10)::DOUBLE AS points FROM range(400) t(i);

# --- a join a view makes between two loaded tables with no declared relationship is relationship_test on the view,
# yellow, a should; its fix declares the relationship toward the side a stored profile says holds each key once

statement ok
DECLARE DATASET harm SET (purpose: 'a joined table');

statement ok
USE harm;

statement ok
CREATE TABLE harm.drivers AS SELECT i AS driver_id, 'driver ' || i AS surname FROM range(5) t(i);

statement ok
CREATE TABLE harm.results AS SELECT i AS result_id, i % 6 AS driver_id, (i % 10)::DOUBLE AS points FROM range(60) t(i);

statement ok
GLOSS driver_results ON harm AS $${"kind": "table", "sql": "SELECT r.result_id, d.surname, r.points FROM harm.drivers d JOIN harm.results r ON d.driver_id = r.driver_id"}$$;

query TTTTT
SELECT level, kind, state, starts_with(open, 'relationship_test'), contains(statement, 'DECLARE RELATIONSHIP harm.results.driver_id -> harm.drivers.driver_id;')
FROM next WHERE asset = 'harm.driver_results' AND contains(statement, 'DECLARE RELATIONSHIP');
----
should	test	yellow	true	true

statement ok
DECLARE RELATIONSHIP harm.results.driver_id -> harm.drivers.driver_id;

query T
SELECT state FROM view_tests() WHERE view = 'driver_results' AND test = 'relationship_test';
----
green

# --- a metric that serves no series is series_test on the metric, red, a must; the roles it asks for close it

statement ok
GLOSS points_per_driver ON harm AS $${"kind": "metric", "sql": "SELECT DATE '2024-01-01' + result_id::INTEGER AS day, points AS value FROM harm.results"}$$;

query TTT
SELECT level, kind, state FROM next WHERE asset = 'harm.points_per_driver' AND starts_with(open, 'series_test');
----
must	test	red

statement ok
GLOSS role ON harm.points_per_driver.day AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON harm.points_per_driver.value AS $${"value": "measure"}$$;

query T
SELECT state FROM view_tests() WHERE view = 'points_per_driver' AND test = 'series_test';
----
green

# --- a result an actor computes that read a result out of date is possibly out of date: it stays out of
# next; the result it read computed again with the same value leaves it current, with another value it
# enters next

statement ok
USE grid;

statement ok
DECLARE PROPERTY top_points WITH $${"type": "number"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION top_points FOR grid AS $$ SELECT max(points) AS n FROM grid.results $$ RETURNS top_points;

statement ok
DECLARE PROPERTY top_seen WITH $${"type": "number"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION top_seen FOR grid AS $$ SELECT max(value::DOUBLE) AS n FROM results('top_points', 'itself') $$ RETURNS top_seen;

statement ok
SELECT top_points(), top_seen() FROM grid;

statement ok
INSERT INTO grid.results VALUES (DATE '2024-03-01', 1, 3.0);

query TT
SELECT function, reason FROM glossql_outdated() WHERE function IN ('top_points', 'top_seen') ORDER BY ALL;
----
top_points	changed
top_seen	possibly

query T
SELECT state FROM GLOSSARY(grid) WHERE property = 'top_seen';
----
possibly

statement ok
SELECT top_points() FROM grid;

query I
SELECT count(*) FROM next WHERE contains(statement, 'top_');
----
0

statement ok
INSERT INTO grid.results VALUES (DATE '2024-03-02', 1, 30.0);

statement ok
SELECT top_points() FROM grid;

query TTT
SELECT function, what, reason FROM glossql_outdated() WHERE function IN ('top_points', 'top_seen') ORDER BY ALL;
----
top_seen	result top_points	changed

# --- a column whose name is no plain name: the statement results_due() hands out quotes it, and it runs

statement ok
COPY (SELECT 'k' || (i % 3) AS kind, i * 1.5 AS amount FROM range(9) t(i)) TO '{TEST_DIR}/kinds.csv' (HEADER);

statement ok
DECLARE DATASET shop SET (purpose: 'odd column names');

statement ok
USE shop;

statement ok
DECLARE SOURCE files SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE items ON shop FROM files AS $$SELECT * FROM read_csv('kinds.csv')$$;

statement ok
GLOSS per_kind ON shop AS $${"kind": "table", "sql": "SELECT kind, count(*), sum(amount) AS \"order\" FROM items GROUP BY kind"}$$;

statement ok
GLOSS kinds ON shop AS $${"kind": "table", "sql": "SELECT p.kind, p.\"count_star()\" AS n, p.\"order\" AS total FROM per_kind p"}$$;

# each write is followed by the results due, as the server follows it: the profiles of the odd columns are stored
query TT
SELECT subject, error IS NULL FROM results WHERE function = 'column_profile' AND subject IN ('shop.per_kind.count_star()', 'shop.per_kind.order') ORDER BY ALL;
----
shop.per_kind.count_star()	true
shop.per_kind.order	true

query I
SELECT count(*) FROM results_due();
----
0


# --- a result someone computed on a loaded table's column is computed again when the table loads, with no
# test and no view that wants it

statement ok
COPY (SELECT i AS n FROM range(9) t(i)) TO '{TEST_DIR}/counts.csv' (HEADER);

statement ok
DECLARE RECIPE counts ON shop FROM files AS $$SELECT * FROM read_csv('counts.csv')$$;

statement ok
SELECT column_profile() FROM shop.counts.n;

query I
SELECT (value->>'total')::INT FROM results WHERE function = 'column_profile' AND subject = 'shop.counts.n';
----
9

statement ok
COPY (SELECT i AS n FROM range(12) t(i)) TO '{TEST_DIR}/counts.csv' (HEADER);

statement ok
IMPORT counts;

query I
SELECT (value->>'total')::INT FROM results WHERE function = 'column_profile' AND subject = 'shop.counts.n';
----
12

query I
SELECT count(*) FROM results_due();
----
0

# --- a rule view that reads stored measurements is tested again when a load changes them: its rows follow
# the column's profile, and its lineage scans no loaded table

statement ok
GLOSS many_counts ON shop AS $${"kind": "rule", "sql": "SELECT subject, (value->>'total')::INT AS total FROM main.results WHERE dataset = 'shop' AND function = 'column_profile' AND subject = 'shop.counts.n' AND (value->>'total')::INT > 12"}$$;

query I
SELECT count(*) FROM main.views_scans('shop') WHERE view = 'many_counts';
----
0

query I
SELECT (value->>'rows')::INT FROM results WHERE function = 'rule_check' AND subject = 'shop.many_counts';
----
0

statement ok
COPY (SELECT i AS n FROM range(15) t(i)) TO '{TEST_DIR}/counts.csv' (HEADER);

statement ok
IMPORT counts;

query II
SELECT (value->>'total')::INT, (SELECT (value->>'rows')::INT FROM results WHERE function = 'rule_check' AND subject = 'shop.many_counts')
FROM results WHERE function = 'column_profile' AND subject = 'shop.counts.n';
----
15	1

query I
SELECT count(*) FROM results_due();
----
0

query I
SELECT count(*) FROM results_due();
----
0
