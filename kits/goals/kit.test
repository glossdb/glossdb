# name: kits/goals/kit.test
# description: the goals kit — what the server computes after a write (`results_due()`) and the work list `next`, on the kits before it; run again, it holds
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_goals_lake/');

statement ok
