# the newest month falls far outside its expected range: the range test is red, a must on the dataset with the
# result's own finding and fix. Work on the dataset is not complete; once a person accepts the change with the
# statement the fix hands over, it is
statement ok
CREATE OR REPLACE MACRO main.service(path, body) AS '{"table":{"member":["orders","orders","orders","orders","orders"],"period":["2025-06","2025-06","2025-06","2025-06","2025-06"],"level":[0.05,0.1,0.5,0.9,0.95],"value":[100,110,120,130,140],"actual":[190,190,190,190,190],"pit":[0.999,0.999,0.999,0.999,0.999],"displacement":[0.998,0.998,0.998,0.998,0.998],"withheld":[null,null,null,null,null]},"answer":{"service":"glossthesi","version":"test","errors":[],"backtest":{"threshold":0.98,"members":[{"member":"orders","column":"value","backtested":1,"held_80":1.0,"held_90":1.0,"period":"2025-06","score":0.998,"state":"red"}]}}}'::JSON;

statement ok
SELECT metric_ranges() FROM ops;

query TTTTTT
SELECT level, kind, asset, state, starts_with(open, 'range_test: orders is 190'),
       contains(statement, 'GLOSS metric_ranges ON ops AS $${"tolerance": 0.998')
FROM next WHERE level = 'must';
----
must	test	ops	red	true	true

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS metric_ranges ON ops AS $${"tolerance": 0.998, "basis": "a new customer in June, confirmed by sales"}$$;

statement ok
RESET VARIABLE glossql_actor;

query II
SELECT count(*) FILTER (WHERE level = 'must'), count(*) FILTER (WHERE level IN ('should', 'could')) > 0 FROM next;
----
0	true

# --- a test of one's own on a column a view reads. The property holds the expectation, annotated on the one
# column: `next` does not ask for it on the other assets the views read. Its row in `next` carries the check's
# finding, the check to run again and the annotation that records a rate a person accepts, with the
# expectation's own words kept; view_tests() names the check as `run`. The count of open tests in
# workspace_status is compared with the count before the test was declared

statement ok
CREATE TABLE memory.main.open_before AS SELECT open FROM workspace_status WHERE area = 'tests';

statement ok
DECLARE ASPECT price_rule WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS FACT ON COLUMN;

statement ok
DECLARE FUNCTION price_check FOR ops AS $$SELECT count(*) FILTER (WHERE price <= 11) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) FILTER (WHERE price <= 11) || ' rows are priced at 11 or under' AS finding FROM ops.orders_raw$$ RETURNS price_rule;

statement ok
DECLARE TEST price_test ON price_rule BY (AGENT, HUMAN) DETECTOR rate_tolerance;

# declared and set nowhere: nothing asks for it
query II
SELECT (SELECT count(*) FROM next WHERE contains(statement, 'price_rule')),
       (SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests');
----
0	0

statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.0, "basis": "the price list starts at 12"}$$;

# set on the one column and not run: the test waits there, with the check as its statement, and counts as open once
query TTT
SELECT kind, asset, state FROM next WHERE contains(statement, 'price_rule') OR contains(statement, 'price_check');
----
test	ops.orders_raw.price	yellow

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
1

statement ok
SELECT price_check() FROM ops.orders_raw.price;

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
0

query TT
SELECT state, run FROM view_tests() WHERE test = 'price_test' AND view = 'orders';
----
red	SELECT price_check() FROM ops.orders_raw.price

query TTTTT
SELECT state, starts_with(open, 'price_test: ') AND contains(open, 'rows are priced'),
       contains(statement, 'SELECT price_check() FROM ops.orders_raw.price;'),
       contains(statement, 'GLOSS price_rule ON ops.orders_raw.price AS') AND contains(statement, '"tolerance":'),
       contains(statement, '"outcome":"a price is above 11"')
FROM next WHERE kind = 'test' AND asset = 'ops.orders_raw.price' AND for_view = 'orders';
----
red	true	true	true	true

# the expectation is asked for on no other asset: no row of `next` names it as missing
query I
SELECT count(*) FROM next WHERE kind = 'describe' AND contains(statement, 'price_rule');
----
0

# a tolerance above the measured rate, with its basis, turns the test green and closes the row
statement ok
GLOSS price_rule ON ops.orders_raw.price AS $${"outcome": "a price is above 11", "tolerance": 0.7, "basis": "sales lead: the two low price points are promotions"}$$;

query T
SELECT state FROM view_tests() WHERE test = 'price_test' AND view = 'orders';
----
green

query I
SELECT count(*) FROM next WHERE kind = 'test' AND asset = 'ops.orders_raw.price';
----
0

# a test on a measurement is set where its check ran, and is asked for nowhere else
statement ok
DECLARE ASPECT staff_rule WITH $${"type": "object", "properties": {"breach_rate": {"type": "number"}, "finding": {"type": ["string", "null"]}}}$$ AS MEASUREMENT ON COLUMN;

statement ok
DECLARE FUNCTION staff_check FOR ops AS $$SELECT count(*) FILTER (WHERE staff < 1) / greatest(count(*), 1)::DOUBLE AS breach_rate, NULL::VARCHAR AS finding FROM ops.orders_raw$$ RETURNS staff_rule;

statement ok
DECLARE TEST staff_test ON staff_rule DETECTOR rate_tolerance THRESHOLD 0.0;

query I
SELECT open - (SELECT open FROM memory.main.open_before) FROM workspace_status WHERE area = 'tests';
----
0

# --- each assumption that waits for a person is a should row of `next`, as open_questions counts them; `entity` is
# asked on a table view, with its grain, and not on a metric

statement ok
DECLARE ASPECT order_list WITH $${"title": "Orders, listed", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS order_list ON ops AS $${"sql": "SELECT month, orders FROM ops.orders_raw", "assumptions": [{"dimension": "scope", "key": "all-months", "assumption": "every month is kept", "basis": "the rows", "confidence": 0.7}, {"dimension": "scope", "key": "staff-left-out", "assumption": "staff is left out", "basis": "not asked for", "confidence": 0.6}]}$$;

query II
SELECT (SELECT count(*) FROM next WHERE who = 'person' AND asset = 'ops.order_list' AND level = 'should' AND kind = 'review'),
       (SELECT count(*) FROM open_questions WHERE aspect = 'order_list');
----
2	2

query II
SELECT count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.order_list AS') AND contains(statement, '"grain"')),
       count(*) FILTER (WHERE contains(statement, 'GLOSS entity ON ops.orders AS'))
FROM next WHERE kind = 'describe';
----
1	0

# --- view_definitions: a metric's kind is measure; a view's meaning is the annotation on the view; a view
# with no formula has none

query TTT
SELECT kind, meaning, formula IS NULL FROM view_definitions WHERE name = 'orders';
----
measure	orders taken per month	true

query T
SELECT kind FROM view_definitions WHERE name = 'order_list';
----
relation

# --- every kind of view closes the row to define one, a stopped one does not. A test of one's own on a table view
# is set on the view: its row names the view, its check and the statement that accepts its rate, and the table view's
# own columns are asked to be described

statement ok
DECLARE DATASET side SET (purpose: 'views of every kind');

statement ok
USE side;

statement ok
CREATE TABLE side.ledger AS SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
  ['general', 'water', 'parks'][i % 3 + 1] AS fund FROM range(120) r(i);

statement ok
DECLARE ASPECT ledger_rows WITH $${"title": "Ledger rows", "x-kind": "scalar"}$$ AS VIEW;

statement ok
GLOSS ledger_rows ON side AS $${"sql": "SELECT count(*) AS value FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE kind = 'integrate';
----
0

statement ok
GLOSS ledger_rows ON side AS $${"stopped": "the count is read elsewhere"}$$;

query TT
SELECT asset, state FROM next WHERE kind = 'integrate';
----
side	missing

statement ok
DECLARE ASPECT ledger_clean WITH $${"title": "Ledger, cleaned", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS ledger_clean ON side AS $${"sql": "SELECT booked, amount, fund FROM side.ledger"}$$;

query I
SELECT count(*) FROM next WHERE kind = 'integrate';
----
0

statement ok
DECLARE ASPECT fund_coded WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "rows": {"type": "integer"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION fund_coded_check FOR side AS $$SELECT count(*) FILTER (WHERE fund NOT IN ('general', 'water')) / greatest(count(*), 1)::DOUBLE AS breach_rate, count(*) AS rows FROM side.ledger_clean$$ RETURNS fund_coded;

statement ok
DECLARE TEST fund_coded_test ON fund_coded BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS fund_coded ON ledger_clean AS $${"outcome": "each fund is in the code table", "tolerance": 0.0, "basis": "the code table lists every fund"}$$;

statement ok
SELECT fund_coded_check() FROM ledger_clean;

query TTTTT
SELECT level, state, for_view, contains(statement, 'fund_coded_check()'), contains(statement, 'GLOSS fund_coded ON side.ledger_clean AS')
FROM next WHERE kind = 'test' AND asset = 'side.ledger_clean' AND starts_with(open, 'fund_coded_test');
----
must	red	ledger_clean	true	true

query II
SELECT (SELECT count(*) FROM next WHERE kind = 'describe' AND contains(statement, 'fund_coded')),
       (SELECT count(*) FROM next WHERE kind = 'describe' AND asset = 'side.ledger_clean' AND contains(statement, 'side.ledger_clean.fund'));
----
0	1

# --- a check that fails is stored with its error: not due again after a write it did not read, due again once what it read moves

statement ok
DECLARE ASPECT fund_named WITH $${"type": "object", "properties": {"outcome": {"type": "string"}, "tolerance": {"type": "number"}, "basis": {"type": "string"}, "breach_rate": {"type": "number"}, "rows": {"type": "integer"}}}$$ AS FACT ON TABLE;

statement ok
DECLARE FUNCTION fund_named_check FOR side AS $$SELECT CASE WHEN count(*) FILTER (WHERE fund IS NULL) > 0 THEN error('fund_missing: a row names no fund') ELSE 0.0 END AS breach_rate, count(*) AS rows FROM side.ledger_clean$$ RETURNS fund_named;

statement ok
DECLARE TEST fund_named_test ON fund_named BY (AGENT, HUMAN) DETECTOR rate_tolerance;

statement ok
GLOSS fund_named ON ledger_clean AS $${"outcome": "every row names its fund", "tolerance": 0.0, "basis": "a booking without a fund cannot be reported"}$$;

statement ok
INSERT INTO side.ledger SELECT booked, amount, NULL FROM side.ledger LIMIT 1;

statement error
SELECT fund_named_check() FROM ledger_clean;
----
fund_missing

query TT
SELECT current, error IS NOT NULL FROM GLOSSARY(ledger_clean, all => true) WHERE aspect = 'fund_named' AND actor = 'function';
----
true	true

statement ok
CREATE TABLE side.unrelated AS SELECT 1 AS x;

query I
SELECT count(*) FROM results_due() WHERE function = 'fund_named';
----
0

statement ok
INSERT INTO side.ledger SELECT booked, amount, 'water' FROM side.ledger LIMIT 1;

query T
SELECT run FROM results_due() WHERE function = 'fund_named';
----
SELECT fund_named_check() FROM side.ledger_clean

# --- a check on a metric depends on the annotations of what the metric reads: an annotation on a
# table no metric reads computes nothing, a role on a column one metric scans computes that metric's check

statement ok
DECLARE DATASET grid SET (purpose: 'two metrics over one table');

statement ok
USE grid;

statement ok
CREATE TABLE grid.results AS SELECT DATE '2024-01-01' + (i % 40)::INTEGER AS date, i % 7 AS driver_id, (i % 10)::DOUBLE AS points FROM range(400) t(i);

statement ok
CREATE TABLE grid.circuits AS SELECT i AS circuit_id, 'circuit ' || i AS name FROM range(5) t(i);

statement ok
DECLARE ASPECT points WITH $${"title": "Points"}$$ AS VIEW;

statement ok
GLOSS points ON grid AS $${"sql": "SELECT date AS period, sum(points) AS value FROM grid.results GROUP BY 1"}$$;

statement ok
DECLARE ASPECT entries WITH $${"title": "Entries"}$$ AS VIEW;

statement ok
GLOSS entries ON grid AS $${"sql": "SELECT date AS period, count(driver_id) AS value FROM grid.results GROUP BY 1"}$$;

statement ok
GLOSS role ON points.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON points.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON points.value AS $${"value": "additive"}$$;

statement ok
GLOSS role ON entries.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON entries.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON entries.value AS $${"value": "additive"}$$;

statement ok
SELECT column_profile() FROM grid.results.date;

statement ok
SELECT column_profile() FROM grid.results.driver_id;

statement ok
SELECT column_profile() FROM grid.results.points;

statement ok
SELECT temporal() FROM grid.entries.period;

statement ok
SELECT temporal() FROM grid.points.period;

# the relationship check is due per relationship between the tables a metric scans, a new one too
statement ok
CREATE TABLE grid.drivers AS SELECT i AS driver_id FROM range(7) t(i);

statement ok
DECLARE ASPECT driver_points WITH $${"title": "Points of known drivers"}$$ AS VIEW;

statement ok
GLOSS driver_points ON grid AS $${"sql": "SELECT r.date AS period, sum(r.points) AS value FROM grid.results r JOIN grid.drivers d ON d.driver_id = r.driver_id GROUP BY 1"}$$;

statement ok
DECLARE RELATIONSHIP results.driver_id -> drivers.driver_id;

query TT
SELECT subject, run FROM results_due() WHERE function = 'relationship_coherence';
----
grid.results.driver_id -> grid.drivers.driver_id	SELECT relationship_coherence() FROM grid.results.driver_id -> grid.drivers.driver_id

statement ok
SELECT relationship_coherence() FROM grid.results.driver_id -> grid.drivers.driver_id;

query I
SELECT count(*) FROM results_due() WHERE function = 'relationship_coherence';
----
0

statement ok
GLOSS driver_points ON grid AS $${"stopped": "not a metric of this test"}$$;

statement ok
SELECT additivity_check(), join_check(), orphan_check() FROM grid.entries;

statement ok
