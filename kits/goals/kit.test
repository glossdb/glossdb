# --- a table view and a single value want what a metric wants: a table view over two joined tables with a
# declared relationship wants the profile of each column it reads (the join columns among them), the coherence
# of the relationship and its own join and orphan checks; an orphaned key makes the orphan check red and `next`
# lists it under test; a single value over one table wants the profile of the column it reads, no other, and its
# own checks; a write that touches nothing the views' checks read wants nothing

statement ok
DECLARE DATASET harm SET (purpose: 'a harmonised table');

statement ok
USE harm;

statement ok
CREATE TABLE harm.drivers AS SELECT i AS driver_id, 'driver ' || i AS surname FROM range(5) t(i);

statement ok
CREATE TABLE harm.results AS SELECT i AS result_id, i % 6 AS driver_id, (i % 10)::DOUBLE AS points FROM range(60) t(i);

statement ok
CREATE TABLE harm.circuits AS SELECT i AS circuit_id, 'circuit ' || i AS name FROM range(3) t(i);

statement ok
DECLARE ASPECT driver_results WITH $${"title": "Results with their driver", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS driver_results ON harm AS $${"sql": "SELECT r.result_id, d.surname, r.points FROM harm.results r JOIN harm.drivers d ON d.driver_id = r.driver_id"}$$;

# the view joins two loaded tables on a column pair no relationship covers: a should under describe, its statement
# the relationship from the join's left input to its right while no profile says which side holds each key once
query TTTTTT
SELECT level, kind, asset, state, for_view, contains(statement, 'DECLARE RELATIONSHIP harm.results.driver_id -> harm.drivers.driver_id;')
FROM next WHERE contains(statement, 'DECLARE RELATIONSHIP');
----
should	describe	harm.results.driver_id -> harm.drivers.driver_id	missing	driver_results	true

statement ok
DECLARE RELATIONSHIP harm.results.driver_id -> harm.drivers.driver_id;

query I
SELECT count(*) FROM next WHERE contains(statement, 'DECLARE RELATIONSHIP');
----
0

query ITT
SELECT ord, function, subject FROM results_due() ORDER BY ord, run;
----
1	column_profile	harm.drivers.driver_id
1	column_profile	harm.drivers.surname
1	column_profile	harm.results.driver_id
1	column_profile	harm.results.points
1	column_profile	harm.results.result_id
1	relationship_coherence	harm.results.driver_id -> harm.drivers.driver_id
2	join_check	harm.driver_results
2	orphan_check	harm.driver_results

statement ok
SELECT column_profile() FROM harm.drivers.driver_id;

statement ok
SELECT column_profile() FROM harm.drivers.surname;

statement ok
SELECT column_profile() FROM harm.results.driver_id;

statement ok
SELECT column_profile() FROM harm.results.points;

statement ok
SELECT column_profile() FROM harm.results.result_id;

statement ok
SELECT relationship_coherence() FROM harm.results.driver_id -> harm.drivers.driver_id;

statement ok
SELECT join_check(), orphan_check() FROM harm.driver_results;

query I
SELECT count(*) FROM results_due();
----
0

# driver 5 has no row in drivers: a sixth of the results find no parent
query TTR
SELECT test, state, round(score, 4) FROM view_tests() WHERE view = 'driver_results' ORDER BY test;
----
join_test	green	0.0
orphan_test	red	0.1667

query TTTTT
SELECT level, asset, state, starts_with(open, 'orphan_test'), contains(statement, 'GLOSS orphan_check ON harm.driver_results AS')
FROM next WHERE kind = 'test';
----
must	harm.driver_results	red	true	true

query I
SELECT count(*) FROM TESTS(harm.driver_results) WHERE state = 'red';
----
1

