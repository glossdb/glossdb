# --- a stored profile turns the relationship round: drivers holds each driver_id once, so the relationship runs
# from laps to drivers, though the join writes drivers first
statement ok
CREATE TABLE harm.laps AS SELECT i AS lap_id, i % 5 AS driver_ref FROM range(20) t(i);

statement ok
DECLARE ASPECT driver_laps WITH $${"title": "Laps with their driver", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS driver_laps ON harm AS $${"sql": "SELECT d.surname, l.lap_id FROM harm.drivers d JOIN harm.laps l ON l.driver_ref = d.driver_id"}$$;

query TT
SELECT asset, contains(statement, 'DECLARE RELATIONSHIP harm.laps.driver_ref -> harm.drivers.driver_id;') FROM next WHERE contains(statement, 'DECLARE RELATIONSHIP');
----
harm.laps.driver_ref -> harm.drivers.driver_id	true

statement ok
DECLARE RELATIONSHIP harm.laps.driver_ref -> harm.drivers.driver_id;

query I
SELECT count(*) FROM next WHERE contains(statement, 'DECLARE RELATIONSHIP');
----
0

# --- a loaded table's stated grain is tested at each load: the server runs grain_check on each table whose entity
# states one; a key the load sends twice is a must on the table, with the keys
statement ok
GLOSS entity ON harm.laps AS $${"value": "one lap", "role": "fact", "grain": ["driver_ref"]}$$;

query ITT
SELECT ord, function, subject FROM results_due() WHERE function = 'grain_check';
----
2	grain_check	harm.laps

statement ok
SELECT grain_check() FROM harm.laps;

query TTTRT
SELECT level, kind, state, (SELECT round(score, 4) FROM view_tests() WHERE test = 'grain_test'),
       (SELECT evidence->>'repeated' FROM view_tests() WHERE test = 'grain_test')
FROM next WHERE asset = 'harm.laps' AND kind = 'test';
----
must	test	red	0.75	15

# the grain stated as the rows have it: green, and no row
statement ok
GLOSS entity ON harm.laps AS $${"value": "one lap", "role": "fact", "grain": ["lap_id"]}$$;

statement ok
SELECT grain_check() FROM harm.laps;

query TI
SELECT (SELECT state FROM view_tests() WHERE test = 'grain_test'), count(*) FROM next WHERE asset = 'harm.laps' AND kind = 'test';
----
green	0

# --- a result an actor computes that read a result out of date is possibly out of date: it stays out of
# next; the result it read computed again with the same value leaves it current, with another value it
# enters next

statement ok
USE grid;

statement ok
DECLARE ASPECT top_points WITH $${"type": "number"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION top_points FOR grid AS $$ SELECT max(points) AS n FROM grid.results $$ RETURNS top_points;

statement ok
DECLARE ASPECT top_seen WITH $${"type": "number"}$$ AS MEASUREMENT ON DATASET;

statement ok
DECLARE FUNCTION top_seen FOR grid AS $$ SELECT max(value::DOUBLE) AS n FROM results('top_points', 'itself') $$ RETURNS top_seen;

statement ok
SELECT top_points(), top_seen() FROM grid;

statement ok
INSERT INTO grid.results VALUES (DATE '2024-03-01', 1, 3.0);

query TT
SELECT function, reason FROM glossql_outdated() WHERE function IN ('top_points', 'top_seen') ORDER BY ALL;
----
top_points	changed
top_seen	possibly

query T
SELECT statement FROM next WHERE contains(statement, 'top_') ORDER BY ALL;
----
SELECT top_points() FROM grid;

query T
SELECT state FROM GLOSSARY(grid) WHERE aspect = 'top_seen';
----
possibly

