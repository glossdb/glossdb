# name: kits/goals/kit.test
# description: the goals kit — what the server computes after a write (`results_due()`) and the work list `next`, its rows by level and kind of work, on the kits before it, with and without the outlook kit; run again, it holds
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_goals_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{KITS}/core/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/kpi/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/quality/kit.sql');

statement ok
FROM glossql_kit('{KITS}/views/kit.sql');

statement ok
FROM glossql_kit('{KITS}/goals/kit.sql');

query I
SELECT count(*) FROM results_due();
----
0

# with no table in the dataset, the list has one row: a source to connect and a table to load, which must be done
query TTTT
SELECT level, kind, state, who FROM next;
----
must	integrate	missing	agent

query TT
FROM glossql_kit('{KITS}/goals/kit.sql');
----
goals	current

# --- the levels. A table no view reads is described on request (could); with no view, one must be defined.
# A metric served: what its view reads is to be described (should). The outlook kit is a pull-in: loaded, with a
# model service named, it changes neither `next` nor view_tests() while no preview result is stored

statement ok
COPY (SELECT (DATE '2023-01-01' + INTERVAL (m) MONTH)::DATE AS month, 100.0 + m AS orders, 10.0 + m % 3 AS price, 5 AS staff
      FROM range(30) r(m)) TO '{TEST_DIR}/orders.csv' (HEADER);

statement ok
DECLARE DATASET ops SET (purpose: 'orders per month');

statement ok
USE ops;

statement ok
DECLARE SOURCE erp SET (type: csv, location: '{TEST_DIR}');

statement ok
DECLARE RECIPE orders_raw ON ops FROM erp AS $$SELECT CAST(month AS DATE) AS month, CAST(orders AS DOUBLE) AS orders, CAST(price AS DOUBLE) AS price, CAST(staff AS INTEGER) AS staff FROM read_csv('orders.csv')$$;

query TTTT
SELECT level, kind, asset, state FROM next;
----
must	integrate	ops	missing
could	describe	ops.orders_raw	missing

statement ok
DECLARE ASPECT orders WITH $${"title": "Orders"}$$ AS VIEW;

statement ok
GLOSS orders ON ops AS $${"sql": "SELECT month, orders AS value, price FROM ops.orders_raw"}$$;

statement ok
GLOSS role ON orders.month AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON orders.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON orders.value AS $${"value": "additive"}$$;

statement ok
GLOSS time_grains ON orders.month AS $${"floor": "month"}$$;

statement ok
GLOSS meaning ON ops.orders AS $${"value": "orders taken per month"}$$;

query TT
SELECT applicable, floor FROM view_summary() WHERE view = 'orders';
----
true	month

# the view's column price has no role: the summary row and `next` ask for it with the same statement, on the
# view's own column, as should
query TTT
SELECT n.level, contains(s.missing[1], 'ops.orders.price'), contains(n.statement, s.missing[1])
FROM (SELECT missing FROM view_summary() WHERE view = 'orders') s,
     (SELECT level, statement FROM next WHERE kind = 'describe' AND asset = 'ops.orders' AND state = 'missing') n;
----
should	true	true

# nothing must be done: the dataset is complete. Its tests not run yet are should, the columns no view reads could
query TTTT
SELECT level, kind, asset, state FROM next WHERE kind <> 'describe' OR level <> 'should' ORDER BY ALL;
----
could	describe	ops.orders_raw	missing
should	test	ops.orders	not_run
should	test	ops.orders	not_run
should	test	ops.orders	not_run

statement ok
CREATE TABLE memory.main.next_without AS SELECT * FROM next;

statement ok
CREATE TABLE memory.main.tests_without AS SELECT * EXCLUDE (evidence), evidence::VARCHAR AS evidence FROM view_tests();

statement ok
FROM glossql_kit('{KITS}/plan/kit.sql');

statement ok
FROM glossql_kit('{KITS}/outlook/kit.sql');

statement ok
SET GLOBAL glossql_service_url = 'http://model.test';

query II
SELECT (SELECT count(*) FROM (FROM next EXCEPT ALL FROM memory.main.next_without)),
       (SELECT count(*) FROM (FROM memory.main.next_without EXCEPT ALL FROM next));
----
0	0

query II
SELECT (SELECT count(*) FROM (SELECT * EXCLUDE (evidence), evidence::VARCHAR FROM view_tests() EXCEPT ALL FROM memory.main.tests_without)),
       (SELECT count(*) FROM (FROM memory.main.tests_without EXCEPT ALL SELECT * EXCLUDE (evidence), evidence::VARCHAR FROM view_tests()));
----
0	0

query I
SELECT count(*) FROM kits;
----
8

# every shipped measurement reads the data of its subject's dataset alone: no table named, and no dataset but
# the subject's (a read past the read functions is refused at the declaration)
query I
SELECT count(*)
FROM main.functions f, unnest(from_json(f.reads, '[{"kind": "VARCHAR", "read": "VARCHAR", "what": "VARCHAR", "where": "VARCHAR", "constant": "BOOLEAN"}]')) u(r)
WHERE f.returns IS NOT NULL AND f.declared_by LIKE 'kit:%'
  AND ((r.kind = 'data' AND r."where" IS NULL AND r.read NOT IN ('dataset_cells', 'subject_column', 'glossql_relationship_checks'))
       OR (r.kind = 'data' AND r.read IN ('dataset_cells', 'subject_column') AND NOT regexp_matches(r.what, '^[<$]')));
----
0

# --- a kit's stored results in `next`: an actor runs a preview function (the model service is stood in for); the
# server computes none after a write. Current and green, it is no row;
# out of date, it is a should with the statement that computes it again; a red test on it is a must with the test's
# own finding and fix

statement ok
CREATE OR REPLACE MACRO main.service(path, body) AS (CASE
  WHEN path = '/whatif' THEN '{"table":{"member":["orders","orders"],"period":["2025-08-01","2025-08-01"],"column":["value","value"],"status":["plan","scenario"],"level":[0.5,0.5],"value":[130,120],"effect":[null,-10]},"answer":{"service":"glossthesi","version":"test","errors":[],"changed":["orders.price"],"parts":[]}}'
  WHEN json_extract(body, '$.spec.origins') IS NOT NULL
    THEN '{"table":{"member":["orders","orders","orders","orders","orders"],"period":["2025-06","2025-06","2025-06","2025-06","2025-06"],"level":[0.05,0.1,0.5,0.9,0.95],"value":[100,110,120,130,140],"actual":[129,129,129,129,129],"pit":[0.7,0.7,0.7,0.7,0.7],"displacement":[0.4,0.4,0.4,0.4,0.4],"withheld":[null,null,null,null,null]},"answer":{"service":"glossthesi","version":"test","errors":[],"backtest":{"threshold":0.98,"members":[{"member":"orders","column":"value","backtested":1,"held_80":1.0,"held_90":1.0,"period":"2025-06","score":0.4,"state":"green"}]}}}'
  ELSE '{"table":{"member":["orders","orders","orders","orders","orders"],"origin":["2025-06-01","2025-06-01","2025-06-01","2025-06-01","2025-06-01"],"step":[1,1,1,1,1],"span":[null,null,null,null,null],"period":["2025-07-01","2025-07-01","2025-07-01","2025-07-01","2025-07-01"],"column":["value","value","value","value","value"],"level":[0.05,0.1,0.5,0.9,0.95],"value":[100,110,120,130,140],"coverage_80":[0.75,0.75,0.75,0.75,0.75]},"answer":{"service":"glossthesi","version":"test","errors":[]}}' END)::JSON;

statement ok
SELECT metric_ranges() FROM ops;

statement ok
SELECT metric_forecast() FROM ops.orders;

query TTT
SELECT subject, state, current FROM TESTS() WHERE test = 'range_test';
----
ops	green	true

