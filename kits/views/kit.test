# --- a table view has no series either, though one of its columns is a timestamp; the semantic model takes a
# table's key from the grain of its entity and a metric's description from the meaning annotated on the view

statement ok
DECLARE ASPECT ledger_lines WITH $${"title": "Ledger lines", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS ledger_lines ON fin AS $${"sql": "SELECT booked, amount, fund FROM fin.ledger"}$$;

statement ok
GLOSS role ON ledger_lines.booked AS $${"value": "timestamp"}$$;

statement ok
GLOSS time_grains ON ledger_lines.booked AS $${"floor": "day"}$$;

query TTTTTT
SELECT kind, applicable IS NULL, reason IS NULL, period_column IS NULL, floor IS NULL, window_periods IS NULL
FROM view_summary() WHERE view = 'ledger_lines';
----
relation	true	true	true	true	true

# a table view asks for no role on its columns either: amount and fund carry none
query II
SELECT len(columns_without_role), len(missing) FROM view_summary() WHERE view = 'ledger_lines';
----
0	0

statement ok
GLOSS entity ON ledger AS $${"value": "one booking", "role": "fact", "grain": ["booked", "fund"], "time_axis": "booked"}$$;

statement ok
GLOSS meaning ON fin.spend AS $${"value": "money booked per month"}$$;

query TT
SELECT (SELECT json_extract(d, '$.primary_key')::VARCHAR FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract_string(d, '$.name') = 'ledger'),
       (SELECT json_extract_string(d, '$.metrics[0].description') FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract_string(d, '$.name') = 'spend')
FROM semantic_model();
----
["booked","fund"]	money booked per month

