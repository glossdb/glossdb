----
green	NULL

# --- completeness: a column a view serves that a load or a new definition empties, judged on each column. A
# status code read out of the status text by a regex; a note filled on one row in ten. The check on a column reads
# its profile and the profiles of the columns it is computed from, and the values each profile held before. One
# statement over a table or a view profiles each of its columns, one over the view checks each of its columns
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, CASE WHEN i % 10 = 0 THEN 'note ' || i END AS note FROM range(100) r(i);

statement ok
DECLARE ASPECT line_status WITH $${"title": "Line status", "x-kind": "relation"}$$ AS VIEW;

statement ok
GLOSS line_status ON fin AS $${"sql": "SELECT line_id, nullif(regexp_extract(status, '^\\((\\w+)\\)', 1), '') AS code, note FROM fin.status_lines"}$$;

statement ok
SELECT lineage() FROM fin.line_status;

statement ok
SELECT column_profile() FROM fin.status_lines;

statement ok
SELECT column_profile() FROM fin.line_status;

statement ok
SELECT completeness_check() FROM fin.line_status;

statement ok
SELECT completeness_test() FROM fin;

query TTRT
SELECT subject, state, score, (evidence->>'applicable')::BOOLEAN FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	green	0.0	true
fin.line_status.line_id	green	0.0	true
fin.line_status.note	green	0.0	true

# a load that empties a column 90% empty before: it rose by a tenth of the rows, within the threshold, and stays quiet
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, NULL::VARCHAR AS note FROM range(100) r(i);

statement ok
SELECT lineage() FROM fin.line_status;

statement ok
SELECT column_profile() FROM fin.status_lines;

statement ok
SELECT column_profile() FROM fin.line_status;

statement ok
SELECT completeness_check() FROM fin.line_status;

statement ok
SELECT completeness_test() FROM fin;

query TT
SELECT subject, state FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	green
fin.line_status.line_id	green
fin.line_status.note	green

# the definition recorded again with the regex's backslashes doubled: the code matches no row. The code is red,
# with its share before and now, and the definition as the cause, since status is filled; the other columns
# stay green
statement ok
GLOSS line_status ON fin AS $${"sql": "SELECT line_id, nullif(regexp_extract(status, '^\\\\((\\\\w+)\\\\)', 1), '') AS code, note FROM fin.status_lines"}$$;

statement ok
SELECT lineage() FROM fin.line_status;

statement ok
SELECT column_profile() FROM fin.status_lines;

statement ok
SELECT column_profile() FROM fin.line_status;

statement ok
SELECT completeness_check() FROM fin.line_status;

statement ok
SELECT completeness_test() FROM fin;

query TTRRRT
SELECT subject, state, score, (evidence->>'before')::DOUBLE, (evidence->>'now')::DOUBLE, evidence->>'emptied_by'
FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	red	1.0	0.0	1.0	definition
fin.line_status.line_id	green	0.0	NULL	NULL	NULL
fin.line_status.note	green	0.0	NULL	NULL	NULL

# the fix hands the definition to correct, and the statement that accepts the rate on the column alone
query TT
SELECT contains(evidence->>'fix', 'GLOSS line_status ON fin AS $${"sql"'),
       contains(evidence->>'fix', 'GLOSS completeness_check ON fin.line_status.code AS $${"tolerance": 1.0')
FROM view_tests() WHERE subject = 'fin.line_status.code' AND test = 'completeness_test';
----
true	true

# the same rows loaded again: the code's check is out of date, and computed again it is red as before
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, NULL::VARCHAR AS note FROM range(100) r(i);

query T
