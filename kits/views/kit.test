# name: kits/views/kit.test
# description: the metrics kit — a metric is a view whose columns carry the vocabulary; the fact row per metric, the series over the collapsed values and the view, the no-claim refusal, the time_grains, facts, sources
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_metrics_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/kpi/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/quality/kit.sql');

statement ok
FROM glossql_kit('{KITS}/views/kit.sql');

statement ok
DECLARE DATASET fin SET (purpose: 'metrics');

statement ok
USE fin;

# a flow sliced two ways, booked daily, served monthly
statement ok
CREATE TABLE fin.ledger AS
  SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
         ['general', 'water', 'parks'][i % 3 + 1] AS fund, ['salaries', 'supplies'][i % 2 + 1] AS object
  FROM range(120) r(i);

statement ok
DECLARE ASPECT spend WITH $${"title": "Spend"}$$ AS VIEW;

statement ok
GLOSS spend ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS value, fund, object FROM fin.ledger GROUP BY ALL"}$$;

# --- the fact row: what the view's columns owe before anything is said

query TTTT
SELECT view, applicable, (reason) IS NOT NULL, columns_without_role FROM view_summary();
----
spend	false	true	[period, value, fund, object]

query T
SELECT missing[1] FROM view_summary();
----
GLOSS role ON fin.spend.period AS $${"value": "<key|measure|dimension|timestamp|attribute>"}$$;

statement ok
GLOSS role ON spend.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON spend.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON spend.fund AS $${"value": "dimension"}$$;

statement ok
GLOSS dimension ON spend.fund AS $${"value": "primary"}$$;

statement ok
GLOSS role ON spend.object AS $${"value": "dimension"}$$;

# the roles are annotated and no grain is measured: the row lists the profile to run
query TTTT
SELECT applicable, (reason) IS NOT NULL, dims, measurements_to_run FROM view_summary();
----
false	true	[fund, object]	[temporal over fin.spend.period]

statement ok
SELECT temporal() FROM spend.period;

query TTTTTTTTTT
SELECT applicable, period_column, value_column, grain_detected, floor, window_periods, additivity, additivity_state, dims, profile_current FROM view_summary();
----
true	period	value	month	month	48	NULL	none	[fund, object]	true

# --- the no-claim rule: rows have to be combined and nobody said how

statement error
SELECT * FROM metric_series();

statement ok
GLOSS additivity ON spend.value AS $${"value": "additive"}$$;

# the total at the floor, by the primary slice, at a coarser grain; a finer grain serves no rows
query TTTR
SELECT metric, dimension, period::DATE, value FROM metric_series() WHERE dimension = '' ORDER BY period;
----
spend	(empty)	2024-01-01	118.0
spend	(empty)	2024-02-01	116.0
spend	(empty)	2024-03-01	130.0
spend	(empty)	2024-04-01	113.0

query TTR
SELECT member, period::DATE, value FROM metric_series() WHERE dimension = 'fund' AND member = 'water' ORDER BY period;
----
water	2024-01-01	36.0
water	2024-02-01	42.0
water	2024-03-01	41.0
water	2024-04-01	40.0

query TTR
SELECT world, period::DATE, value FROM metric_series(grain := 'quarter') WHERE dimension = '' ORDER BY period;
----
actual	2024-01-01	364.0
actual	2024-04-01	113.0

query I
SELECT count(*) FROM metric_series(grain := 'day');
----
0

# a flow's empty period is a zero cell in the total
statement ok
DELETE FROM fin.ledger WHERE booked >= DATE '2024-02-01' AND booked < DATE '2024-03-01';

query TR
SELECT period::DATE, value FROM metric_series() WHERE dimension = '' ORDER BY period;
----
2024-01-01	118.0
2024-02-01	0.0
2024-03-01	130.0
2024-04-01	113.0

# a flow whose rows stopped early shows its zeros to the data's edge — the last instant another metric reaches
statement ok
CREATE TABLE fin.later AS SELECT DATE '2024-06-15' AS seen, 7.0 AS level;

statement ok
DECLARE ASPECT reach WITH $${"title": "Reach"}$$ AS VIEW;

statement ok
GLOSS reach ON fin AS $${"sql": "SELECT seen AS period, level AS value FROM fin.later"}$$;

statement ok
GLOSS role ON reach.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON reach.value AS $${"value": "measure"}$$;

statement ok
GLOSS time_grains ON reach.period AS $${"floor": "month"}$$;

statement ok
GLOSS additivity ON reach.value AS $${"value": "semi-additive"}$$;

query TTR
SELECT metric, period::DATE, value FROM metric_series() WHERE dimension = '' AND period >= DATE '2024-04-01' ORDER BY metric, period;
----
reach	2024-06-01	7.0
spend	2024-04-01	113.0
spend	2024-05-01	0.0
spend	2024-06-01	0.0

statement ok
GLOSS reach ON fin AS $${"stopped": "one row, no series"}$$;

# --- where each column comes from: the column mapping, read off the view's SQL

# every column has its row with the column it is computed from, the summed value and a column passed
# through unchanged alike; no row stands for a table alone
query TTTTT
SELECT target_column, branch, source_table, source_column, expression FROM column_mapping('spend') ORDER BY target_column, source_column;
----
fund	1	ledger	fund	fin.ledger.fund:VARCHAR
object	1	ledger	object	fin.ledger.object:VARCHAR
period	1	ledger	booked	cast(date_trunc('month', fin.ledger.booked:TIMESTAMP) as DATE)
value	1	ledger	amount	sum(fin.ledger.amount:DOUBLE)

# a column computed by a CASE or a COALESCE comes from the columns inside it; a table read under three
# aliases reads as three reads, the coalesce's order kept; a column named with a blank passes through
statement ok
CREATE TABLE fin.products AS SELECT i AS id, CASE WHEN i % 2 = 0 THEN 'D' ELSE 'A' END AS status, 'brand' || i AS global_brand, i AS parent, i * 1.5 AS "unit price" FROM range(4) t(i);

statement ok
DECLARE ASPECT product_forms WITH $${"title": "Product forms"}$$ AS VIEW;

statement ok
GLOSS product_forms ON fin AS $${"sql": "SELECT p.id, CASE WHEN p.status = 'D' THEN 'available' ELSE 'other' END AS availability, coalesce(p.global_brand, up.global_brand, top.global_brand) AS brand, p.\"unit price\" FROM fin.products p JOIN fin.products up ON p.parent = up.id JOIN fin.products top ON up.parent = top.id"}$$;

query TTTTTT
SELECT target_column, source_table, source_column, alias, array_to_string(literals, ' '), complete FROM column_mapping('product_forms') ORDER BY target_column, alias;
----
availability	products	status	p	'D' 'available' 'other'	true
brand	products	global_brand	p	(empty)	true
brand	products	global_brand	top	(empty)	true
brand	products	global_brand	up	(empty)	true
id	products	id	p	(empty)	true
unit price	products	unit price	p	(empty)	true

statement ok
GLOSS product_forms ON fin AS $${"stopped": "the lineage case only"}$$;

# --- a stock: the period's last level, summed over what holds at that instant

statement ok
CREATE TABLE fin.levels AS SELECT * FROM (VALUES
  (DATE '2024-01-31', 'ops', 10.0), (DATE '2024-01-31', 'sales', 4.0),
  (DATE '2024-02-29', 'ops', 11.0), (DATE '2024-02-29', 'sales', 5.0),
  (DATE '2024-03-31', 'ops', 12.0), (DATE '2024-03-31', 'sales', 5.0),
  (DATE '2024-04-30', 'ops', 12.0), (DATE '2024-04-30', 'sales', 6.0)) t(d, dept, n);

statement ok
DECLARE ASPECT headcount WITH $${"title": "Headcount"}$$ AS VIEW;

statement ok
GLOSS headcount ON fin AS $${"sql": "SELECT d AS period, n AS value, dept FROM fin.levels"}$$;

statement ok
GLOSS role ON headcount.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON headcount.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON headcount.dept AS $${"value": "dimension"}$$;

statement ok
SELECT temporal() FROM headcount.period;

statement ok
GLOSS additivity ON headcount.value AS $${"value": "semi-additive"}$$;

query TR
SELECT period::DATE, value FROM metric_series() WHERE metric = 'headcount' AND dimension = '' ORDER BY period;
----
2024-01-01	14.0
2024-02-01	16.0
2024-03-01	17.0
2024-04-01	18.0

query TTTR
SELECT dimension, member, period::DATE, value FROM metric_series(grain := 'quarter') WHERE metric = 'headcount' ORDER BY dimension, member, period;
----
(empty)	(empty)	2024-01-01	17.0
(empty)	(empty)	2024-04-01	18.0
dept	ops	2024-01-01	12.0
dept	ops	2024-04-01	12.0
dept	sales	2024-01-01	5.0
dept	sales	2024-04-01	6.0

# --- a ratio re-divides its summed halves, which the view serves as columns the claim names

statement ok
CREATE TABLE fin.offers AS SELECT * FROM (VALUES
  (DATE '2024-01-15', 'ops', 3, 4), (DATE '2024-02-15', 'ops', 1, 4),
  (DATE '2024-01-15', 'sales', 2, 2), (DATE '2024-02-15', 'sales', 0, 2)) t(d, dept, won, offered);

statement ok
DECLARE ASPECT win_rate WITH $${"title": "Win rate"}$$ AS VIEW;

statement ok
GLOSS win_rate ON fin AS $${"sql": "SELECT d AS period, dept, won, offered, won / offered AS value FROM fin.offers"}$$;

statement ok
GLOSS role ON win_rate.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON win_rate.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON win_rate.dept AS $${"value": "dimension"}$$;

statement ok
GLOSS additivity ON win_rate.value AS $${"value": "ratio", "numerator": "won", "denominator": "offered"}$$;

statement ok
SELECT temporal() FROM win_rate.period;

query TTRRR
SELECT dimension, period::DATE, value, num, den FROM metric_series() WHERE metric = 'win_rate' AND dimension = '' ORDER BY period;
----
(empty)	2024-01-01	0.8333333333333334	5.0	6.0
(empty)	2024-02-01	0.16666666666666666	1.0	6.0

query TTRRR
SELECT member, period::DATE, value, num, den FROM metric_series(grain := 'quarter') WHERE metric = 'win_rate' ORDER BY dimension, member;
----
(empty)	2024-01-01	0.5	6.0	12.0
ops	2024-01-01	0.5	4.0	8.0
sales	2024-01-01	0.5	2.0	4.0

# --- the time_grains: a floor coarser than the measured grain, and a window of one period

statement ok
GLOSS time_grains ON headcount.period AS $${"floor": "quarter", "windows": {"quarter": 1}}$$;

query TTI
SELECT grain_detected, floor, window_periods FROM view_summary() WHERE view = 'headcount';
----
month	quarter	1

query TR
SELECT period::DATE, value FROM metric_series() WHERE metric = 'headcount' AND dimension = '' ORDER BY period;
----
2024-04-01	18.0

# --- a new definition with other sql: the claims on the view's columns read stale, served and marked

statement ok
GLOSS headcount ON fin AS $${"sql": "SELECT d AS period, n * 1 AS value, dept FROM fin.levels"}$$;

query TTTT
SELECT applicable, profile_current, additivity, additivity_state FROM view_summary() WHERE view = 'headcount';
----
true	false	semi-additive	stale

# the profile out of date is run again: every function that reads the view's grain reads it, so the server
# computes it after the write
query T
SELECT measurements_to_run FROM view_summary() WHERE view = 'headcount';
----
[temporal over fin.headcount.period]

# --- a single value serves one number; a stopped view serves its reason

statement ok
DECLARE ASPECT fte_cap WITH $${"title": "FTE cap", "x-kind": "scalar"}$$ AS VIEW;

statement ok
GLOSS fte_cap ON fin AS $${"sql": "SELECT 40 AS value"}$$;

query TRT
SELECT * FROM fact_values();
----
fte_cap	40.0	NULL

# a single value has no series: what belongs to a series is NULL on its row, and no reason is given
query TTTTT
SELECT applicable IS NULL, reason IS NULL, period_column IS NULL, floor IS NULL, window_periods IS NULL
FROM view_summary() WHERE view = 'fte_cap';
----
true	true	true	true	true

statement ok
GLOSS win_rate ON fin AS $${"stopped": "offers are not booked before 2024"}$$;

query TT
SELECT applicable, reason FROM view_summary() WHERE view = 'win_rate';
----
false	stopped: offers are not booked before 2024

query I
SELECT count(*) FROM metric_series() WHERE metric = 'win_rate';
----
0

# --- a list over every metric skips what needs a claim nobody made, and says so in the fact row

statement ok
GLOSS additivity ON headcount.value AS $${"value": "non-additive"}$$;

query I
SELECT count(DISTINCT metric) FROM metric_series(unclaimed := 'skip');
----
1

# a metric marked non-additive whose rows would have to be combined is left out; it does not refuse the read
query I
SELECT count(DISTINCT metric) FROM metric_series();
----
1

# --- the built-in tests: a metric over one table cannot fan out and has no join to check; its additivity is its additivity

statement ok
SELECT join_check() FROM fin.spend;

statement ok
SELECT orphan_check() FROM fin.spend;

statement ok
SELECT additivity_check() FROM fin.spend;

# the completeness check is on each column the view serves, computed by one statement over the view; it
# reads the profile of the column, which the server computes first, and until it is stored it is not applicable
statement ok
SELECT completeness_check() FROM fin.spend;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test(), completeness_test() FROM fin;

query TTTTT
SELECT test, subject, declared_by, state, run FROM view_tests() WHERE view = 'spend' ORDER BY test, subject;
----
completeness_test	fin.spend.fund	kit:views	yellow	SELECT completeness_check() FROM fin.spend
completeness_test	fin.spend.object	kit:views	yellow	SELECT completeness_check() FROM fin.spend
completeness_test	fin.spend.period	kit:views	yellow	SELECT completeness_check() FROM fin.spend
completeness_test	fin.spend.value	kit:views	yellow	SELECT completeness_check() FROM fin.spend
join_test	fin.spend	kit:views	green	SELECT join_check() FROM fin.spend
measure_additivity_test	fin.spend	kit:views	green	SELECT additivity_check() FROM fin.spend
orphan_test	fin.spend	kit:views	green	SELECT orphan_check() FROM fin.spend

# a single value carries the join, orphan and completeness tests, green where it reads no table, and not the
# additivity test, which needs a measure; a stopped definition has no tests of this kind
statement ok
SELECT column_profile() FROM fin.fte_cap.value;

statement ok
SELECT join_check(), orphan_check(), completeness_check() FROM fin.fte_cap;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test(), completeness_test() FROM fin;

query TT
SELECT test, state FROM view_tests() WHERE view IN ('fte_cap', 'win_rate') ORDER BY view, test;
----
completeness_test	green
join_test	green
orphan_test	green

# a metric joining two tables on a column whose values repeat on both sides fans out: the definition's own join and the columns' profiles are the evidence, and until they are profiled the test says so
statement ok
CREATE TABLE fin.notes AS SELECT CASE WHEN i < 90 THEN i ELSE i - 90 END AS line_id, 'note ' || i AS text FROM range(100) r(i);

statement ok
CREATE TABLE fin.lines AS SELECT (i % 90) AS line_id, DATE '2024-01-01' + INTERVAL (i) DAY AS booked, 1.0 AS amount FROM range(270) r(i);

statement ok
DECLARE ASPECT noted_spend WITH $${"title": "Noted spend"}$$ AS VIEW;

statement ok
GLOSS noted_spend ON fin AS $${"sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM fin.lines l JOIN fin.notes n ON n.line_id = l.line_id GROUP BY ALL"}$$;

statement ok
SELECT join_check() FROM fin.noted_spend;

statement ok
SELECT orphan_check() FROM fin.noted_spend;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TTT
SELECT test, state, (json_extract_string(evidence, '$.reason')) IS NOT NULL FROM view_tests() WHERE view = 'noted_spend' AND test IN ('join_test', 'orphan_test') ORDER BY test;
----
join_test	yellow	true
orphan_test	green	true

# the profiles are stored: the check's result predates them and says so, and the next run reads them
statement ok
SELECT column_profile() FROM fin.lines.line_id;

statement ok
SELECT column_profile() FROM fin.notes.line_id;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT state, current FROM view_tests() WHERE view = 'noted_spend' AND test = 'join_test';
----
yellow	false

statement ok
SELECT join_check() FROM fin.noted_spend;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TTT
SELECT state, current, json_extract_string(evidence, '$.pairs') FROM view_tests() WHERE view = 'noted_spend' AND test = 'join_test';
----
red	true	["lines.line_id ~ notes.line_id"]

# the same join with one side reduced to one row per line inside the definition cannot multiply rows: green, whatever the table holds, by GROUP BY and by the latest row per key alike
statement ok
DECLARE ASPECT noted_spend_grouped WITH $${"title": "Noted spend, one note per line"}$$ AS VIEW;

statement ok
GLOSS noted_spend_grouped ON fin AS $${"sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM (SELECT line_id, sum(amount) AS amount, min(booked) AS booked FROM fin.lines GROUP BY line_id) l JOIN fin.notes n ON n.line_id = l.line_id GROUP BY ALL"}$$;

statement ok
DECLARE ASPECT noted_spend_latest WITH $${"title": "Noted spend, the latest booking per line"}$$ AS VIEW;

statement ok
GLOSS noted_spend_latest ON fin AS $${"sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM fin.notes n JOIN (SELECT * FROM fin.lines QUALIFY row_number() OVER (PARTITION BY line_id ORDER BY booked DESC) = 1) l ON n.line_id = l.line_id GROUP BY ALL"}$$;

statement ok
SELECT join_check() FROM fin.noted_spend_grouped;

statement ok
SELECT join_check() FROM fin.noted_spend_latest;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT view, state FROM view_tests() WHERE view LIKE 'noted_spend_%' AND test = 'join_test' ORDER BY view;
----
noted_spend_grouped	green
noted_spend_latest	green

# referential integrity on the relationships the metric joins over: one coherence result per relationship
statement ok
CREATE TABLE fin.customers AS SELECT i AS customer_id, 'c' || i AS name, (i + 1) % 5 AS region_id FROM range(80) r(i);

statement ok
CREATE TABLE fin.regions AS SELECT i AS region_id FROM range(5) r(i);

statement ok
CREATE TABLE fin.orders AS SELECT i AS order_id, i % 100 AS customer_id, i % 5 AS region_id, DATE '2024-01-01' + INTERVAL (i) DAY AS booked, 10.0 AS amount FROM range(200) r(i);

statement ok
DECLARE RELATIONSHIP orders.customer_id -> customers.customer_id;

statement ok
DECLARE ASPECT customer_sales WITH $${"title": "Customer sales"}$$ AS VIEW;

statement ok
GLOSS customer_sales ON fin AS $${"sql": "SELECT date_trunc('month', o.booked)::DATE AS period, sum(o.amount) AS value, c.name FROM fin.orders o JOIN fin.customers c ON c.customer_id = o.customer_id JOIN fin.regions g ON g.region_id = o.region_id GROUP BY ALL"}$$;

statement ok
SELECT relationship_coherence() FROM orders.customer_id -> customers.customer_id;

statement ok
SELECT orphan_check() FROM fin.customer_sales;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT state, json_extract_string(evidence, '$.edges[0].relationship') FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	fin.orders.customer_id -> fin.customers.customer_id

# a relationship declared after its check ran has no result yet: the check is not applicable until it has
statement ok
DECLARE RELATIONSHIP orders.region_id -> regions.region_id;

statement ok
SELECT orphan_check() FROM fin.customer_sales;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT state, json_extract_string(evidence, '$.applicable') FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
yellow	false

statement ok
SELECT relationship_coherence() FROM orders.region_id -> regions.region_id;

statement ok
SELECT orphan_check() FROM fin.customer_sales;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT state, json_extract_string(evidence, '$.breach_rate') FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	0.2

# a relationship between the tables the metric reads on columns it does not join on is not judged: every order misses its composite key, the rate stays that of the joins
statement ok
DECLARE RELATIONSHIP orders.(customer_id, region_id) -> customers.(customer_id, region_id);

statement ok
SELECT relationship_coherence() FROM orders.(customer_id, region_id) -> customers.(customer_id, region_id);

statement ok
SELECT orphan_check() FROM fin.customer_sales;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TTII
SELECT state, json_extract_string(evidence, '$.breach_rate'), json_array_length(evidence->'edges'),
       (SELECT count(*) FROM measurements WHERE function = 'relationship_coherence' AND subject LIKE '%(customer_id, region_id)%' AND (value->>'orphan_rate')::DOUBLE > 0.2)
FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	0.2	2	1

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

# a built-in test that is red brings its finding and its fix
query I
SELECT count(*) FROM view_tests() WHERE state = 'red' AND declared_by = 'kit:views'
  AND (evidence->>'finding' IS NULL OR evidence->>'fix' IS NULL);
----
0

# --- an effective-dated table read without its validity dates: the scan's columns are the evidence

statement ok
CREATE TABLE fin.prices AS SELECT (i % 40) AS line_id, DATE '2024-01-01' + INTERVAL (i * 30) DAY AS valid_from, DATE '2024-01-01' + INTERVAL (i * 30 + 30) DAY AS valid_to, 2.0 AS price FROM range(120) r(i);

statement ok
GLOSS validity ON fin.prices AS $${"valid_from": "valid_from", "valid_to": "valid_to"}$$;

statement ok
DECLARE ASPECT priced_spend WITH $${"title": "Priced spend"}$$ AS VIEW;

statement ok
GLOSS priced_spend ON fin AS $${"sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount * p.price) AS value FROM fin.lines l JOIN fin.prices p ON p.line_id = l.line_id GROUP BY ALL"}$$;

statement ok
SELECT join_check() FROM fin.priced_spend;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TT
SELECT state, json_extract_string(evidence, '$.tables') FROM view_tests() WHERE view = 'priced_spend' AND test = 'join_test';
----
red	["prices (valid_from, valid_to)"]

statement ok
GLOSS priced_spend ON fin AS $${"sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount * p.price) AS value FROM fin.lines l JOIN fin.prices p ON p.line_id = l.line_id AND p.valid_from <= l.booked AND p.valid_to > l.booked GROUP BY ALL"}$$;

statement ok
SELECT join_check() FROM fin.priced_spend;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query T
SELECT state FROM view_tests() WHERE view = 'priced_spend' AND test = 'join_test';
----
green

# --- the semantic model as an Apache Ossie document: a dataset per table and per served metric, time and dimension fields, the metric's expression

query TTT
SELECT json_extract_string(document, '$.version'), json_extract_string(document, '$.name'),
       (SELECT list(json_extract_string(d, '$.name') ORDER BY 1) FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract(d, '$.metrics') IS NOT NULL)::VARCHAR
FROM semantic_model();
----
0.3.0.dev0	fin	[headcount, spend]

query TT
SELECT json_extract_string(f, '$.name'), json_extract(f, '$.dimension.is_time')::VARCHAR
FROM semantic_model(), unnest(json_extract(document, '$.datasets')::JSON[]) t(d), unnest(json_extract(d, '$.fields')::JSON[]) u(f)
WHERE json_extract_string(d, '$.name') = 'spend' AND json_extract(f, '$.dimension') IS NOT NULL ORDER BY 1;
----
fund	false
object	false
period	true

# --- fan-out reads the join the definition makes: two tables read side by side with no join cannot fan out, whatever their columns share

statement ok
DECLARE ASPECT all_lines WITH $${"title": "All lines"}$$ AS VIEW;

statement ok
GLOSS all_lines ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, count(*) AS value FROM (SELECT booked, line_id FROM fin.lines UNION ALL SELECT DATE '2024-01-01', line_id FROM fin.notes) GROUP BY ALL"}$$;

statement ok
SELECT join_check() FROM fin.all_lines;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query T
SELECT state FROM view_tests() WHERE view = 'all_lines' AND test = 'join_test';
----
green

# an accepted rate is no conflict: the tolerance the test offers settles it
statement ok
GLOSS join_check ON fin.noted_spend AS $${"tolerance": 1.0, "basis": "every note of a line is counted on purpose"}$$;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query T
SELECT state FROM view_tests() WHERE view = 'noted_spend' AND test = 'join_test'
UNION ALL SELECT state FROM GLOSSARY(fin.noted_spend) WHERE aspect = 'join_check';
----
green
current

# --- lineage as OpenLineage run events: one per view, its inputs the tables it scans, its output's columns traced to theirs

query TTT
SELECT json_extract_string(event, '$.eventType'), json_extract_string(event, '$.job.name'),
       json_extract_string(event, '$.outputs[0].facets.columnLineage.fields.value.inputFields[0].field')
FROM lineage_events() WHERE json_extract_string(event, '$.job.name') = 'view.fin.spend';
----
COMPLETE	view.fin.spend	amount

# --- the additivity test reads how the value is computed: a ratio of two aggregates marked additive is red, and so is a metric that sums it; marked ratio with its two halves it is green

statement ok
DECLARE ASPECT amount_per_line WITH $${"title": "Amount per line"}$$ AS VIEW;

statement ok
GLOSS amount_per_line ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS num, count(*) AS den, sum(amount) / count(*) AS value FROM fin.lines GROUP BY 1"}$$;

statement ok
DECLARE ASPECT amount_per_line_year WITH $${"title": "Amount per line, by year"}$$ AS VIEW;

statement ok
GLOSS amount_per_line_year ON fin AS $${"sql": "SELECT date_trunc('year', period)::DATE AS period, sum(value) AS value FROM fin.amount_per_line GROUP BY 1"}$$;

statement ok
GLOSS role ON amount_per_line.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON amount_per_line.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON amount_per_line.value AS $${"value": "additive"}$$;

statement ok
GLOSS role ON amount_per_line_year.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON amount_per_line_year.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON amount_per_line_year.value AS $${"value": "additive"}$$;

statement ok
SELECT additivity_check() FROM fin.amount_per_line;

statement ok
SELECT additivity_check() FROM fin.amount_per_line_year;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query TTT
SELECT view, state, json_extract_string(evidence, '$.shape') FROM view_tests()
WHERE view LIKE 'amount_per_line%' AND test = 'measure_additivity_test' ORDER BY 1;
----
amount_per_line	red	ratio
amount_per_line_year	red	ratio

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

# the fix a red additivity test brings is the metric's current definition, to edit and record again
query T
SELECT contains(evidence->>'fix', 'GLOSS amount_per_line ON fin AS $${"sql"') FROM view_tests()
WHERE view = 'amount_per_line' AND test = 'measure_additivity_test';
----
true

statement ok
GLOSS amount_per_line ON fin AS $${"sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS num, count(*) AS den, sum(amount) / count(*) AS value FROM fin.lines GROUP BY 1"}$$;

statement ok
GLOSS additivity ON amount_per_line.value AS $${"value": "ratio", "numerator": "num", "denominator": "den"}$$;

statement ok
SELECT additivity_check() FROM fin.amount_per_line;

statement ok
SELECT role_test(), additivity_test(), unit_test(), grain_test(), join_test(), measure_additivity_test(), orphan_test() FROM fin;

query T
SELECT state FROM view_tests() WHERE view = 'amount_per_line' AND test = 'measure_additivity_test';
----
green

