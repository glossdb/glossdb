# name: kits/views/kit.test
# description: the metrics kit — a metric is a view whose columns carry the vocabulary; the fact row per metric, the series over the collapsed values and the view, the no-claim refusal, the time_grains, facts, sources
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_metrics_lake/');

statement ok
USE ws;

statement ok
PRAGMA glossql;

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/kpi/kit.sql');

statement ok
FROM glossql_kit('{GLOSSQL_KITS}/quality/kit.sql');

statement ok
FROM glossql_kit('{KITS}/core/kit.sql');

statement ok
FROM glossql_kit('{KITS}/views/kit.sql');

statement ok
FROM glossql_kit('{KITS}/goals/kit.sql');

statement ok
DECLARE DATASET fin SET (purpose: 'metrics');

statement ok
USE fin;

# a flow sliced two ways, booked daily, served monthly
statement ok
CREATE TABLE fin.ledger AS
  SELECT DATE '2024-01-01' + INTERVAL (i) DAY AS booked, (i % 7 + 1)::DOUBLE AS amount,
         ['general', 'water', 'parks'][i % 3 + 1] AS fund, ['salaries', 'supplies'][i % 2 + 1] AS object
  FROM range(120) r(i);

statement ok
GLOSS spend ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS value, fund, object FROM fin.ledger GROUP BY ALL"}$$;

# --- the fact row: what the view's columns owe before anything is said

query TTTT
SELECT view, applicable, (reason) IS NOT NULL, columns_without_role FROM view_summary();
----
spend	false	true	[period, value, fund, object]

statement ok
GLOSS role ON spend.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON spend.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON spend.fund AS $${"value": "dimension"}$$;

statement ok
GLOSS dimension ON spend.fund AS $${"value": "primary"}$$;

statement ok
GLOSS role ON spend.object AS $${"value": "dimension"}$$;

query TTTTTTTTTT
SELECT applicable, period_column, value_column, grain_detected, floor, window_periods, additivity, additivity_state, dims, profile_current FROM view_summary();
----
true	period	value	month	month	48	NULL	none	[fund, object]	true

# --- the no-claim rule: rows have to be combined and nobody said how

statement error
SELECT * FROM metric_series();

statement ok
GLOSS additivity ON spend.value AS $${"value": "additive"}$$;

# the total at the floor, by the primary slice, at a coarser grain; a finer grain serves no rows
query TTTR
SELECT metric, dimension, period::DATE, value FROM metric_series() WHERE dimension = '' ORDER BY period;
----
spend	(empty)	2024-01-01	118.0
spend	(empty)	2024-02-01	116.0
spend	(empty)	2024-03-01	130.0
spend	(empty)	2024-04-01	113.0

query TTR
SELECT member, period::DATE, value FROM metric_series() WHERE dimension = 'fund' AND member = 'water' ORDER BY period;
----
water	2024-01-01	36.0
water	2024-02-01	42.0
water	2024-03-01	41.0
water	2024-04-01	40.0

query TTR
SELECT world, period::DATE, value FROM metric_series(grain := 'quarter') WHERE dimension = '' ORDER BY period;
----
actual	2024-01-01	364.0
actual	2024-04-01	113.0

query I
SELECT count(*) FROM metric_series(grain := 'day');
----
0

# --- where each column comes from: the column mapping, read off the view's SQL

# every column has its row with the column it is computed from, the summed value and a column passed
# through unchanged alike; no row stands for a table alone
query TTTTT
SELECT target_column, branch, source_table, source_column, expression FROM column_mapping('spend') ORDER BY target_column, source_column;
----
fund	1	ledger	fund	fin.ledger.fund:VARCHAR
object	1	ledger	object	fin.ledger.object:VARCHAR
period	1	ledger	booked	cast(date_trunc('month', fin.ledger.booked:TIMESTAMP) as DATE)
value	1	ledger	amount	sum(fin.ledger.amount:DOUBLE)

# a column computed by a CASE or a COALESCE comes from the columns inside it; a table read under three
# aliases reads as three reads, the coalesce's order kept; a column named with a blank passes through
statement ok
CREATE TABLE fin.products AS SELECT i AS id, CASE WHEN i % 2 = 0 THEN 'D' ELSE 'A' END AS status, 'brand' || i AS global_brand, i AS parent, i * 1.5 AS "unit price" FROM range(4) t(i);

statement ok
GLOSS product_forms ON fin AS $${"kind": "metric", "sql": "SELECT p.id, CASE WHEN p.status = 'D' THEN 'available' ELSE 'other' END AS availability, coalesce(p.global_brand, up.global_brand, top.global_brand) AS brand, p.\"unit price\" FROM fin.products p JOIN fin.products up ON p.parent = up.id JOIN fin.products top ON up.parent = top.id"}$$;

query TTTTTT
SELECT target_column, source_table, source_column, alias, array_to_string(literals, ' '), complete FROM column_mapping('product_forms') ORDER BY target_column, alias;
----
availability	products	status	p	'D' 'available' 'other'	true
brand	products	global_brand	p	(empty)	true
brand	products	global_brand	top	(empty)	true
brand	products	global_brand	up	(empty)	true
id	products	id	p	(empty)	true
unit price	products	unit price	p	(empty)	true

statement ok
GLOSS product_forms ON fin AS $${"stopped": "the lineage case only"}$$;

# --- a stock: the period's last level, summed over what holds at that instant

statement ok
CREATE TABLE fin.levels AS SELECT * FROM (VALUES
  (DATE '2024-01-31', 'ops', 10.0), (DATE '2024-01-31', 'sales', 4.0),
  (DATE '2024-02-29', 'ops', 11.0), (DATE '2024-02-29', 'sales', 5.0),
  (DATE '2024-03-31', 'ops', 12.0), (DATE '2024-03-31', 'sales', 5.0),
  (DATE '2024-04-30', 'ops', 12.0), (DATE '2024-04-30', 'sales', 6.0)) t(d, dept, n);

statement ok
GLOSS headcount ON fin AS $${"kind": "metric", "sql": "SELECT d AS period, n AS value, dept FROM fin.levels"}$$;

statement ok
GLOSS role ON headcount.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON headcount.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON headcount.dept AS $${"value": "dimension"}$$;

statement ok
GLOSS additivity ON headcount.value AS $${"value": "semi-additive"}$$;

query TR
SELECT period::DATE, value FROM metric_series(view := 'headcount') WHERE dimension = '' ORDER BY period;
----
2024-01-01	14.0
2024-02-01	16.0
2024-03-01	17.0
2024-04-01	18.0

# --- one metric's read: another metric's missing additivity does not refuse it, its own does; a flow whose
# rows stop early fills zeros up to the newest instant of the dataset's metrics

statement ok
GLOSS early ON fin AS $${"kind": "metric", "sql": "SELECT d AS period, n AS value FROM fin.levels WHERE d < DATE '2024-03-01'"}$$;

statement ok
GLOSS role ON early.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON early.value AS $${"value": "measure"}$$;

statement ok
GLOSS time_grains ON early.period AS $${"floor": "month"}$$;

query I
SELECT count(*) FROM metric_series(view := 'spend') WHERE dimension = '';
----
4

statement error
SELECT * FROM metric_series(view := 'early');

statement ok
GLOSS additivity ON early.value AS $${"value": "additive"}$$;

query TR
SELECT period::DATE, value FROM metric_series(view := 'early') WHERE dimension = '' ORDER BY period;
----
2024-01-01	14.0
2024-02-01	16.0
2024-03-01	0.0
2024-04-01	0.0

statement ok
GLOSS early ON fin AS $${"stopped": "the edge case only"}$$;

# --- a ratio re-divides its summed halves, which the view serves as columns the claim names

statement ok
CREATE TABLE fin.offers AS SELECT * FROM (VALUES
  (DATE '2024-01-15', 'ops', 3, 4), (DATE '2024-02-15', 'ops', 1, 4),
  (DATE '2024-01-15', 'sales', 2, 2), (DATE '2024-02-15', 'sales', 0, 2)) t(d, dept, won, offered);

statement ok
GLOSS win_rate ON fin AS $${"kind": "metric", "sql": "SELECT d AS period, dept, won, offered, won / offered AS value FROM fin.offers"}$$;

statement ok
GLOSS role ON win_rate.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON win_rate.value AS $${"value": "measure"}$$;

statement ok
GLOSS role ON win_rate.dept AS $${"value": "dimension"}$$;

statement ok
GLOSS additivity ON win_rate.value AS $${"value": "ratio", "numerator": "won", "denominator": "offered"}$$;

query TTRRR
SELECT member, period::DATE, value, num, den FROM metric_series(view := 'win_rate', grain := 'quarter') ORDER BY dimension, member;
----
(empty)	2024-01-01	0.5	6.0	12.0
ops	2024-01-01	0.5	4.0	8.0
sales	2024-01-01	0.5	2.0	4.0

# --- the time_grains: a floor coarser than the measured grain, and a window of one period

statement ok
GLOSS time_grains ON headcount.period AS $${"floor": "quarter", "windows": {"quarter": 1}}$$;

query TTI
SELECT grain_detected, floor, window_periods FROM view_summary() WHERE view = 'headcount';
----
month	quarter	1

# --- a new definition with other sql: the claims on the view's columns read stale, served and marked

statement ok
GLOSS headcount ON fin AS $${"kind": "metric", "sql": "SELECT d AS period, n * 1 AS value, dept FROM fin.levels"}$$;

# --- a single value serves one number; a stopped view serves its reason

statement ok
GLOSS fte_cap ON fin AS $${"kind": "value", "sql": "SELECT 40 AS value"}$$;

query TRT
SELECT * FROM fact_values();
----
fte_cap	40.0	NULL

# a single value has no series: what belongs to a series is NULL on its row, and no reason is given
query TTTTT
SELECT applicable IS NULL, reason IS NULL, period_column IS NULL, floor IS NULL, window_periods IS NULL
FROM view_summary() WHERE view = 'fte_cap';
----
true	true	true	true	true

statement ok
GLOSS win_rate ON fin AS $${"stopped": "offers are not booked before 2024"}$$;

# --- a list over every metric skips what needs a claim nobody made, and says so in the fact row

statement ok
GLOSS additivity ON headcount.value AS $${"value": "non-additive"}$$;

query I
SELECT count(DISTINCT metric) FROM metric_series(unclaimed := 'skip');
----
1

# a metric marked non-additive whose rows would have to be combined is left out; it does not refuse the read
query I
SELECT count(DISTINCT metric) FROM metric_series();
----
1

# --- the built-in tests: a metric over one table cannot fan out and has no join to check; its additivity is its additivity

# a single value carries the join, orphan, relationship and completeness tests, green where it reads no table, and
# not the additivity and series tests, which need a measure; a stopped definition has no tests of this kind
query TT
SELECT test, state FROM view_tests() WHERE view IN ('fte_cap', 'win_rate') ORDER BY view, test;
----
completeness_test	green
join_test	green
orphan_test	green
relationship_test	green

# a metric joining two tables on a column whose values repeat on both sides fans out: the definition's own join and the columns' profiles are the evidence, and until they are profiled the test says so
statement ok
CREATE TABLE fin.notes AS SELECT CASE WHEN i < 90 THEN i ELSE i - 90 END AS line_id, 'note ' || i AS text FROM range(100) r(i);

statement ok
CREATE TABLE fin.lines AS SELECT (i % 90) AS line_id, DATE '2024-01-01' + INTERVAL (i) DAY AS booked, 1.0 AS amount FROM range(270) r(i);

statement ok
GLOSS noted_spend ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM fin.lines l JOIN fin.notes n ON n.line_id = l.line_id GROUP BY ALL"}$$;

query TTT
SELECT state, current, json_extract_string(evidence, '$.pairs') FROM view_tests() WHERE view = 'noted_spend' AND test = 'join_test';
----
red	true	["lines.line_id ~ notes.line_id"]

# the same join with one side reduced to one row per line inside the definition cannot multiply rows: green, whatever the table holds, by GROUP BY and by the latest row per key alike
statement ok
GLOSS noted_spend_grouped ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM (SELECT line_id, sum(amount) AS amount, min(booked) AS booked FROM fin.lines GROUP BY line_id) l JOIN fin.notes n ON n.line_id = l.line_id GROUP BY ALL"}$$;

statement ok
GLOSS noted_spend_latest ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount) AS value FROM fin.notes n JOIN (SELECT * FROM fin.lines QUALIFY row_number() OVER (PARTITION BY line_id ORDER BY booked DESC) = 1) l ON n.line_id = l.line_id GROUP BY ALL"}$$;

query TT
SELECT view, state FROM view_tests() WHERE view LIKE 'noted_spend_%' AND test = 'join_test' ORDER BY view;
----
noted_spend_grouped	green
noted_spend_latest	green

# referential integrity on the relationships the metric joins over: one coherence result per relationship
statement ok
CREATE TABLE fin.customers AS SELECT i AS customer_id, 'c' || i AS name, (i + 1) % 5 AS region_id FROM range(80) r(i);

statement ok
CREATE TABLE fin.regions AS SELECT i AS region_id FROM range(5) r(i);

statement ok
CREATE TABLE fin.orders AS SELECT i AS order_id, i % 100 AS customer_id, i % 5 AS region_id, DATE '2024-01-01' + INTERVAL (i) DAY AS booked, 10.0 AS amount FROM range(200) r(i);

statement ok
DECLARE RELATIONSHIP orders.customer_id -> customers.customer_id;

statement ok
GLOSS customer_sales ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', o.booked)::DATE AS period, sum(o.amount) AS value, c.name FROM fin.orders o JOIN fin.customers c ON c.customer_id = o.customer_id JOIN fin.regions g ON g.region_id = o.region_id GROUP BY ALL"}$$;

query TT
SELECT state, json_extract_string(evidence, '$.edges[0].relationship') FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	fin.orders.customer_id -> fin.customers.customer_id

# a relationship declared after its check ran has no result yet: the check is not applicable until it has
statement ok
DECLARE RELATIONSHIP orders.region_id -> regions.region_id;

query TT
SELECT state, json_extract_string(evidence, '$.breach_rate') FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	0.2

# a relationship between the tables the metric reads on columns it does not join on is not judged: every order misses its composite key, the rate stays that of the joins
statement ok
DECLARE RELATIONSHIP orders.(customer_id, region_id) -> customers.(customer_id, region_id);

statement ok
SELECT relationship_coherence() FROM orders.(customer_id, region_id) -> customers.(customer_id, region_id);

query TTII
SELECT state, json_extract_string(evidence, '$.breach_rate'), json_array_length(evidence->'edges'),
       (SELECT count(*) FROM results WHERE function = 'relationship_coherence' AND subject LIKE '%(customer_id, region_id)%' AND (value->>'orphan_rate')::DOUBLE > 0.2)
FROM view_tests() WHERE view = 'customer_sales' AND test = 'orphan_test';
----
red	0.2	2	1

# a built-in test that is red brings its finding and its fix
query I
SELECT count(*) FROM view_tests() WHERE state = 'red' AND declared_by = 'kit:views'
  AND (evidence->>'finding' IS NULL OR evidence->>'fix' IS NULL);
----
0

# --- an effective-dated table read without its validity dates: the scan's columns are the evidence

statement ok
CREATE TABLE fin.prices AS SELECT (i % 40) AS line_id, DATE '2024-01-01' + INTERVAL (i * 30) DAY AS valid_from, DATE '2024-01-01' + INTERVAL (i * 30 + 30) DAY AS valid_to, 2.0 AS price FROM range(120) r(i);

statement ok
GLOSS validity ON fin.prices AS $${"valid_from": "valid_from", "valid_to": "valid_to"}$$;

statement ok
GLOSS priced_spend ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount * p.price) AS value FROM fin.lines l JOIN fin.prices p ON p.line_id = l.line_id GROUP BY ALL"}$$;

query TT
SELECT state, json_extract_string(evidence, '$.tables') FROM view_tests() WHERE view = 'priced_spend' AND test = 'join_test';
----
red	["prices (valid_from, valid_to)"]

statement ok
GLOSS priced_spend ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', l.booked)::DATE AS period, sum(l.amount * p.price) AS value FROM fin.lines l JOIN fin.prices p ON p.line_id = l.line_id AND p.valid_from <= l.booked AND p.valid_to > l.booked GROUP BY ALL"}$$;

query T
SELECT state FROM view_tests() WHERE view = 'priced_spend' AND test = 'join_test';
----
green

# --- the semantic model as an Apache Ossie document: a dataset per table and per served metric, time and dimension fields, the metric's expression

query TTT
SELECT json_extract_string(document, '$.version'), json_extract_string(document, '$.name'),
       (SELECT list(json_extract_string(d, '$.name') ORDER BY 1) FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract(d, '$.metrics') IS NOT NULL)::VARCHAR
FROM semantic_model();
----
0.3.0.dev0	fin	[headcount, spend]

query TT
SELECT json_extract_string(f, '$.name'), json_extract(f, '$.dimension.is_time')::VARCHAR
FROM semantic_model(), unnest(json_extract(document, '$.datasets')::JSON[]) t(d), unnest(json_extract(d, '$.fields')::JSON[]) u(f)
WHERE json_extract_string(d, '$.name') = 'spend' AND json_extract(f, '$.dimension') IS NOT NULL ORDER BY 1;
----
fund	false
object	false
period	true

# --- fan-out reads the join the definition makes: two tables read side by side with no join cannot fan out, whatever their columns share

statement ok
GLOSS all_lines ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', booked)::DATE AS period, count(*) AS value FROM (SELECT booked, line_id FROM fin.lines UNION ALL SELECT DATE '2024-01-01', line_id FROM fin.notes) GROUP BY ALL"}$$;

query T
SELECT state FROM view_tests() WHERE view = 'all_lines' AND test = 'join_test';
----
green

# an accepted rate is no conflict: the tolerance the test offers settles it
statement ok
GLOSS join_check ON fin.noted_spend AS $${"tolerance": 1.0, "basis": "every note of a line is counted on purpose"}$$;

query T
SELECT state FROM view_tests() WHERE view = 'noted_spend' AND test = 'join_test'
UNION ALL SELECT state FROM GLOSSARY(fin.noted_spend) WHERE property = 'join_check';
----
green
current

# --- lineage as OpenLineage run events: one per view, its inputs the tables it scans, its output's columns traced to theirs

query TTT
SELECT json_extract_string(event, '$.eventType'), json_extract_string(event, '$.job.name'),
       json_extract_string(event, '$.outputs[0].facets.columnLineage.fields.value.inputFields[0].field')
FROM lineage_events() WHERE json_extract_string(event, '$.job.name') = 'view.fin.spend';
----
COMPLETE	view.fin.spend	amount

# --- the additivity test reads how the value is computed: a ratio of two aggregates marked additive is red, and so is a metric that sums it; marked ratio with its two halves it is green

statement ok
GLOSS amount_per_line ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS num, count(*) AS den, sum(amount) / count(*) AS value FROM fin.lines GROUP BY 1"}$$;

statement ok
GLOSS amount_per_line_year ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('year', period)::DATE AS period, sum(value) AS value FROM fin.amount_per_line GROUP BY 1"}$$;

statement ok
GLOSS role ON amount_per_line.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON amount_per_line.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON amount_per_line.value AS $${"value": "additive"}$$;

statement ok
GLOSS role ON amount_per_line_year.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON amount_per_line_year.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON amount_per_line_year.value AS $${"value": "additive"}$$;

query TTT
SELECT view, state, json_extract_string(evidence, '$.shape') FROM view_tests()
WHERE view LIKE 'amount_per_line%' AND test = 'measure_additivity_test' ORDER BY 1;
----
amount_per_line	red	ratio
amount_per_line_year	red	ratio

# the fix a red additivity test brings is the metric's current definition, to edit and record again
query T
SELECT contains(evidence->>'fix', 'GLOSS amount_per_line ON fin AS $${"kind": "metric", "sql"') FROM view_tests()
WHERE view = 'amount_per_line' AND test = 'measure_additivity_test';
----
true

statement ok
GLOSS amount_per_line ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS num, count(*) AS den, sum(amount) / count(*) AS value FROM fin.lines GROUP BY 1"}$$;

statement ok
GLOSS additivity ON amount_per_line.value AS $${"value": "ratio", "numerator": "num", "denominator": "den"}$$;

query T
SELECT state FROM view_tests() WHERE view = 'amount_per_line' AND test = 'measure_additivity_test';
----
green

# --- a single value asks for no role on its column

query II
SELECT len(columns_without_role), len(missing) FROM view_summary() WHERE view = 'fte_cap';
----
0	0

# --- a table view has no series either, though one of its columns is a timestamp; the semantic model takes a
# table's key from the grain of its entity and a metric's description from the meaning annotated on the view

statement ok
GLOSS ledger_lines ON fin AS $${"kind": "table", "sql": "SELECT booked, amount, fund FROM fin.ledger"}$$;

statement ok
GLOSS role ON ledger_lines.booked AS $${"value": "timestamp"}$$;

statement ok
GLOSS time_grains ON ledger_lines.booked AS $${"floor": "day"}$$;

query TTTTTT
SELECT kind, applicable IS NULL, reason IS NULL, period_column IS NULL, floor IS NULL, window_periods IS NULL
FROM view_summary() WHERE view = 'ledger_lines';
----
table	true	true	true	true	true

# a table view asks for no role on its columns either: amount and fund carry none
query II
SELECT len(columns_without_role), len(missing) FROM view_summary() WHERE view = 'ledger_lines';
----
0	0

statement ok
GLOSS entity ON ledger AS $${"value": "one booking", "role": "fact", "grain": ["booked", "fund"], "time_axis": "booked"}$$;

statement ok
GLOSS meaning ON fin.spend AS $${"value": "money booked per month"}$$;

query TT
SELECT (SELECT json_extract(d, '$.primary_key')::VARCHAR FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract_string(d, '$.name') = 'ledger'),
       (SELECT json_extract_string(d, '$.metrics[0].description') FROM unnest(json_extract(document, '$.datasets')::JSON[]) t(d)
        WHERE json_extract_string(d, '$.name') = 'spend')
FROM semantic_model();
----
["booked","fund"]	money booked per month

# --- a loaded table whose entity states a grain carries grain_test, with no view: the ledger keeps its grain
query TTT
SELECT view, subject, state FROM view_tests() WHERE test = 'grain_test';
----
(empty)	fin.ledger	green

# a grain the rows do not keep: each line is booked three times, so 180 of the 270 rows repeat a key
statement ok
GLOSS entity ON lines AS $${"value": "one booking of a line", "role": "fact", "grain": ["line_id"]}$$;

query TRII
SELECT state, round(score, 4), (evidence->>'repeated')::INT, len(from_json(evidence->'keys', '["VARCHAR"]'))
FROM view_tests() WHERE test = 'grain_test' AND subject = 'fin.lines';
----
red	0.6667	180	3

# --- a join on a key of two columns is judged on the key as a whole: each column repeats on both sides, but the
# chart of accounts holds each business and code once, and the join repeats no row
statement ok
CREATE TABLE fin.txn AS SELECT i % 3 AS business_id, ['4000', '5000'][i % 2 + 1] AS account, DATE '2024-01-01' + INTERVAL (i) DAY AS booked, 1.0 AS amount FROM range(60) r(i);

statement ok
CREATE TABLE fin.coa AS SELECT b AS business_id, a AS code, 'account ' || a AS name FROM range(3) t(b), (VALUES ('4000'), ('5000')) v(a);

statement ok
GLOSS booked_by_business ON fin AS $${"kind": "table", "sql": "SELECT t.business_id, c.name, t.amount FROM fin.txn t JOIN fin.coa c ON c.business_id = t.business_id AND c.code = t.account"}$$;

query I
SELECT count(*) FROM fin.booked_by_business;
----
60

# no profile and no grain tell which side holds each key once: not applicable, and the fix states the grain
query TTT
SELECT state, (evidence->>'applicable')::BOOLEAN, contains(evidence->>'fix', 'GLOSS entity ON fin.coa AS ')
FROM view_tests() WHERE view = 'booked_by_business' AND test = 'join_test';
----
yellow	false	true

statement ok
GLOSS entity ON coa AS $${"value": "one account of one business", "role": "dimension", "grain": ["business_id", "code"]}$$;

query TT
SELECT state, evidence->>'pairs' FROM view_tests() WHERE view = 'booked_by_business' AND test = 'join_test';
----
green	NULL

# --- completeness: a column a view serves that a load or a new definition empties, judged on each column. A
# status code read out of the status text by a regex; a note filled on one row in ten. The check on a column reads
# its profile and the profiles of the columns it is computed from, and the values each profile held before. One
# statement over a table or a view profiles each of its columns, one over the view checks each of its columns
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, CASE WHEN i % 10 = 0 THEN 'note ' || i END AS note FROM range(100) r(i);

statement ok
GLOSS line_status ON fin AS $${"kind": "table", "sql": "SELECT line_id, nullif(regexp_extract(status, '^\\((\\w+)\\)', 1), '') AS code, note FROM fin.status_lines"}$$;

query TTRT
SELECT subject, state, score, (evidence->>'applicable')::BOOLEAN FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	green	0.0	true
fin.line_status.line_id	green	0.0	true
fin.line_status.note	green	0.0	true

# a load that empties a column 90% empty before: it rose by a tenth of the rows, within the threshold, and stays quiet
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, NULL::VARCHAR AS note FROM range(100) r(i);

query TT
SELECT subject, state FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	green
fin.line_status.line_id	green
fin.line_status.note	green

# the definition recorded again with the regex's backslashes doubled: the code matches no row. The code is red,
# with its share before and now, and the definition as the cause, since status is filled; the other columns
# stay green
statement ok
GLOSS line_status ON fin AS $${"kind": "table", "sql": "SELECT line_id, nullif(regexp_extract(status, '^\\\\((\\\\w+)\\\\)', 1), '') AS code, note FROM fin.status_lines"}$$;

query TTRRRT
SELECT subject, state, score, (evidence->>'before')::DOUBLE, (evidence->>'now')::DOUBLE, evidence->>'emptied_by'
FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	red	1.0	0.0	1.0	definition
fin.line_status.line_id	green	0.0	NULL	NULL	NULL
fin.line_status.note	green	0.0	NULL	NULL	NULL

# the fix hands the definition to correct, and the statement that accepts the rate on the column alone
query TT
SELECT contains(evidence->>'fix', 'GLOSS line_status ON fin AS $${"kind": "table", "sql"'),
       contains(evidence->>'fix', 'GLOSS completeness_check ON fin.line_status.code AS $${"tolerance": 1.0')
FROM view_tests() WHERE subject = 'fin.line_status.code' AND test = 'completeness_test';
----
true	true

# the same rows loaded again: the code's check is out of date, and computed again it is red as before
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, NULL::VARCHAR AS note FROM range(100) r(i);

query TTR
SELECT state, current, score FROM view_tests() WHERE subject = 'fin.line_status.code' AND test = 'completeness_test';
----
red	true	1.0

# a load of more rows that fills the note: the code's profile moves, still empty, and the code stays held
# against its share before it emptied
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, ['(OP) Operating', '(SB) Standby', '(RE) Retired'][i % 3 + 1] AS status, 'note ' || i AS note FROM range(120) r(i);

query TTRRRT
SELECT subject, state, score, (evidence->>'before')::DOUBLE, (evidence->>'now')::DOUBLE, evidence->>'emptied_by'
FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' AND state <> 'green';
----
fin.line_status.code	red	1.0	0.0	1.0	definition

# the definition corrected: the code is filled again
statement ok
GLOSS line_status ON fin AS $${"kind": "table", "sql": "SELECT line_id, nullif(regexp_extract(status, '^\\((\\w+)\\)', 1), '') AS code, note FROM fin.status_lines"}$$;

query I
SELECT count(*) FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' AND state <> 'green';
----
0

# a load that sends the status empty: the code empties with it, and the load is the cause, the status it is
# computed from named
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, NULL::VARCHAR AS status, 'note ' || i AS note FROM range(120) r(i);

query TTRTT
SELECT subject, state, score, evidence->>'emptied_by', evidence->>'sources'
FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' AND state <> 'green';
----
fin.line_status.code	red	1.0	load	["fin.status_lines.status"]

# a person accepts the rate on the code: the code is green, and the note stays held to the threshold
statement ok
GLOSS completeness_check ON fin.line_status.code AS $${"tolerance": 1.0, "basis": "the source stopped sending the status"}$$;

query I
SELECT count(*) FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' AND state <> 'green';
----
0

# a later load that empties the note too: the note is red, the code stays accepted
statement ok
CREATE OR REPLACE TABLE fin.status_lines AS
  SELECT i AS line_id, NULL::VARCHAR AS status, NULL::VARCHAR AS note FROM range(120) r(i);

query TT
SELECT subject, state FROM view_tests() WHERE view = 'line_status' AND test = 'completeness_test' ORDER BY subject;
----
fin.line_status.code	green
fin.line_status.line_id	green
fin.line_status.note	red

query T
SELECT evidence->>'emptied_by' FROM view_tests() WHERE subject = 'fin.line_status.note' AND test = 'completeness_test';
----
load

# a column the view no longer serves: its result retires with the next check over the view
statement ok
GLOSS line_status ON fin AS $${"kind": "table", "sql": "SELECT line_id, nullif(regexp_extract(status, '^\\((\\w+)\\)', 1), '') AS code FROM fin.status_lines"}$$;

query T
SELECT subject FROM results WHERE function IN ('completeness_check', 'completeness_test') AND subject LIKE 'fin.line_status.%' AND subject LIKE '%note';
----

# --- a series over members that are not text: a boolean, a date and a decimal print as their text, a
# missing member as NULL; the sums are those of the view's own rows
statement ok
GLOSS kinds ON fin AS $${"kind": "metric", "sql": "SELECT date_trunc('month', booked)::DATE AS period, sum(amount) AS value, fund = 'water' AS watered, CASE WHEN object = 'supplies' THEN NULL ELSE DATE '2024-01-01' END AS since, 1.50::DECIMAL(4, 2) AS band FROM fin.ledger GROUP BY ALL"}$$;

statement ok
GLOSS role ON kinds.period AS $${"value": "timestamp"}$$;

statement ok
GLOSS role ON kinds.value AS $${"value": "measure"}$$;

statement ok
GLOSS additivity ON kinds.value AS $${"value": "additive"}$$;

statement ok
GLOSS role ON kinds.watered AS $${"value": "dimension"}$$;

statement ok
GLOSS role ON kinds.since AS $${"value": "dimension"}$$;

statement ok
GLOSS role ON kinds.band AS $${"value": "dimension"}$$;

query TTR
SELECT dimension, member, sum(value) FROM metric_series(view := 'kinds') WHERE dimension <> '' GROUP BY ALL ORDER BY dimension, member;
----
band	1.50	477.0
since	2024-01-01	240.0
since	NULL	237.0
watered	false	318.0
watered	true	159.0

# === Views a dataset keeps and does not serve

statement ok
DECLARE DATASET kept SET (purpose: 'views kept beside the served ones');

statement ok
USE kept;

statement ok
CREATE TABLE kept.orders AS
  SELECT i AS order_id, (i % 5)::DOUBLE AS amount, ['open', 'shipped'][i % 2 + 1] AS status FROM range(20) r(i);

statement ok
GLOSS order_amounts ON kept AS $${"kind": "table", "sql": "SELECT order_id, amount FROM kept.orders"}$$;

statement ok
SET VARIABLE open_before = (SELECT list(level || ' ' || kind || ' ' || asset || ' ' || open ORDER BY level, kind, asset, open) FROM next);

# --- a plain view asks for nothing: next is as it was, no test is expected on it, it is not served, and
# nothing is computed for it beyond its lineage (the suite computes what is due after each write, as the
# server does)

statement ok
GLOSS status_counts ON kept AS $${"sql": "SELECT status, count(*) AS n FROM kept.orders GROUP BY status"}$$;

query IIII
SELECT (SELECT list(level || ' ' || kind || ' ' || asset || ' ' || open ORDER BY level, kind, asset, open) FROM next) = getvariable('open_before'),
       (SELECT count(*) FROM view_tests() WHERE view = 'status_counts'),
       (SELECT count(*) FROM view_summary() WHERE view = 'status_counts'),
       (SELECT count(*) FROM main.results WHERE subject LIKE 'kept.status_counts%' AND function <> 'lineage');
----
true	0	0	0

query TTT
SELECT name, kind, sql FROM view_definitions ORDER BY name;
----
order_amounts	table	SELECT order_id, amount FROM kept.orders
status_counts	NULL	SELECT status, count(*) AS n FROM kept.orders GROUP BY status

# --- tags: an actor's list, a person's and an agent's read as one; find() by a tag, a name and the columns a
# view reads; tag_statement() hands the agent's list with the word added

statement ok
GLOSS tags ON kept.status_counts AS $${"value": ["fulfilment"]}$$;

statement ok
GLOSS tags ON kept.orders.status AS $${"value": ["state"]}$$;

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS tags ON kept.orders.status AS $${"value": ["fulfilment", "order state"]}$$;

statement ok
RESET VARIABLE glossql_actor;

query TTTT
SELECT asset, what, kind, matched_on FROM find('FULFIL');
----
kept.status_counts	view	NULL	[tags]
kept.orders.status	column	NULL	[tags]

query TT
SELECT tags, reads FROM find('status') WHERE asset = 'kept.orders.status';
----
[fulfilment, order state, state]	[]

query TT
SELECT asset, matched_on FROM find('status') WHERE what = 'view';
----
kept.status_counts	[name, reads]

query T
SELECT tag_statement('kept.orders.status', ['lifecycle']);
----
GLOSS tags ON kept.orders.status AS $${"value":["state","lifecycle"]}$$;

statement ok
GLOSS tags ON kept.orders.status AS $${"value":["state","lifecycle"]}$$;

query T
SELECT tags FROM find('lifecycle');
----
[fulfilment, order state, state, lifecycle]

# --- a rule view: the kit's rule test runs on it after each write with no statement beyond its definition. Red while it
# returns rows, the count and the first rows its finding; a person accepts the count, an agent cannot; a
# row more than the count accepted, loaded after, makes it red again

statement ok
GLOSS large_orders ON kept AS $${"kind": "rule", "sql": "SELECT order_id, amount FROM kept.orders WHERE amount > 3"}$$;

statement ok
GLOSS known_status ON kept AS $${"kind": "rule", "sql": "SELECT order_id FROM kept.orders WHERE status IS NULL"}$$;

query TTTTT
SELECT view, run, state, evidence->>'rows', json_array_length(evidence->'sample') FROM view_tests() WHERE test = 'rule_test' ORDER BY view;
----
known_status	SELECT rule_check() FROM kept.known_status	green	0	0
large_orders	SELECT rule_check() FROM kept.large_orders	red	4	4

# off a rule view the check does not apply and counts no row: a loaded table's rows break no rule
statement ok
SELECT rule_check() FROM kept.orders;

query TTT
SELECT value->>'applicable', value->>'rows', value->>'reason' IS NOT NULL FROM main.results WHERE function = 'rule_check' AND subject = 'kept.orders';
----
false	NULL	true

# find() finds a view by its kind
query TT
SELECT asset, matched_on FROM find('rule');
----
kept.known_status	[kind]
kept.large_orders	[kind]

query TTT
SELECT level, kind, contains(statement, 'GLOSS rule_check ON kept.large_orders AS $${"accepted": 4,') FROM next WHERE asset = 'kept.large_orders';
----
must	test	true

statement error
GLOSS rule_check ON kept.large_orders AS $${"accepted": 4, "basis": "an agent's word"}$$;

statement ok
SET VARIABLE glossql_actor = 'human';

statement ok
GLOSS rule_check ON kept.large_orders AS $${"accepted": 4, "basis": "orders above 3 are the wholesale ones, checked by hand"}$$;

statement ok
RESET VARIABLE glossql_actor;

query TI
SELECT state, (SELECT count(*) FROM next WHERE asset = 'kept.large_orders') FROM view_tests() WHERE view = 'large_orders';
----
green	0

statement ok
INSERT INTO kept.orders VALUES (20, 4.0, 'open');

query TT
SELECT state, evidence->>'rows' FROM view_tests() WHERE view = 'large_orders';
