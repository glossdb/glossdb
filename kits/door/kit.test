# name: kits/door/kit.test
# description: the door kit — what stands waiting on an act (`owed`) and the core routes of `next`, on the kits before it; run again, it stands
# group: [sql]

require glossql

require json

require parquet

require ducklake

statement ok
ATTACH 'ducklake::memory:' AS ws (DATA_PATH '{TEST_DIR}/glossql_kit_door_lake/');

statement ok
USE ws;

statement ok
