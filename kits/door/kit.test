statement ok
FROM glossql_kit('{KITS}/door/kit.sql');

query I
SELECT count(*) FROM owed;
----
0

query I
SELECT count(*) > 0 FROM routes_core();
----
true

query TT
FROM glossql_kit('{KITS}/door/kit.sql');
----
door	stands

