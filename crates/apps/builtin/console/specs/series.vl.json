{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "frame"
  },
  "height": 220,
  "encoding": {
    "x": {
      "field": "period",
      "type": "temporal",
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "legend": {
        "title": null,
        "orient": "top"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.6,
        "point": {
          "size": 20
        }
      },
      "encoding": {
        "y": {
          "field": "value",
          "type": "quantitative",
          "axis": {
            "title": null
          },
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "period",
            "type": "temporal"
          },
          {
            "field": "series",
            "type": "nominal"
          },
          {
            "field": "value",
            "type": "quantitative",
            "format": ".4~s"
          }
        ]
      }
    }
  ]
}
